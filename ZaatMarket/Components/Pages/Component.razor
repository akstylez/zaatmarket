@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Models
@using ZaatMarket.Data
@using ZaatMarket.Services
@using Microsoft.JSInterop

<style>
    /* Full Page Workspace Setup - Unified Dark Theme */
    .ai-workspace { 
        display: flex; 
        height: calc(100vh - 70px); 
        min-height: 600px;
        background: #0f172a; 
        margin: -28px; 
        font-family: system-ui, -apple-system, sans-serif;
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #475569; }

    /* Sidebar Styling */
    .ai-sidebar {
        width: 280px;
        background: #0b1120;
        color: white;
        display: flex;
        flex-direction: column;
        border-right: 1px solid #1e293b;
    }

    .sidebar-header { padding: 24px 20px; }

    .new-chat-btn {
        width: 100%;
        background: rgba(255, 102, 0, 0.1);
        color: #ff6600;
        border: 1px solid rgba(255, 102, 0, 0.3);
        padding: 14px;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.3s ease;
    }
    .new-chat-btn:hover { 
        background: #ff6600; 
        color: white; 
        box-shadow: 0 4px 15px rgba(255, 102, 0, 0.25);
    }
    .plus-icon { font-size: 1.2rem; font-weight: normal; }

    .history-list { flex: 1; overflow-y: auto; padding: 0 20px; }
    .history-label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; margin: 24px 0 12px 0; font-weight: 700; }
    .loading-text { color: #64748b; font-size: 0.85rem; padding: 10px 0; }

    .history-item {
        width: 100%;
        text-align: left;
        background: transparent;
        border: none;
        color: #94a3b8;
        padding: 12px 14px;
        border-radius: 10px;
        font-size: 0.9rem;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: all 0.2s;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .chat-icon { opacity: 0.7; font-size: 0.85rem; }
    .history-item:hover { background: #1e293b; color: #f8fafc; }
    .history-item.active { background: #1e293b; color: white; font-weight: 600; border-left: 3px solid #ff6600; }

    .sidebar-footer { padding: 20px; border-top: 1px solid #1e293b; }
    .ai-badge { display: inline-flex; align-items: center; gap: 8px; background: #0f172a; color: #94a3b8; padding: 8px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 600; border: 1px solid #1e293b; }
    .glow-dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; box-shadow: 0 0 8px #10b981; }

    /* Main Chat Area */
    .ai-main { flex: 1; display: flex; flex-direction: column; background: #0f172a; position: relative; }

    .chat-header { padding: 16px 30px; border-bottom: 1px solid #1e293b; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(12px); display: flex; justify-content: space-between; align-items: center; z-index: 10; }
    .header-info h2 { margin: 0; font-size: 1.25rem; color: #f8fafc; font-weight: 800; }
    .status-wrapper { display: flex; align-items: center; gap: 6px; margin-top: 4px; }
    .status-dot { width: 8px; height: 8px; background: #ff6600; border-radius: 50%; }
    .status-text { font-size: 0.85rem; color: #94a3b8; font-weight: 500; }
    
    .clear-btn { background: transparent; border: 1px solid #334155; color: #cbd5e1; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 0.85rem; font-weight: 600; transition: 0.2s; }
    .clear-btn:hover { background: #ef4444; color: white; border-color: #ef4444; }

    .chat-window { flex: 1; overflow-y: auto; padding: 30px 24px; scroll-behavior: smooth; }
    .chat-content-constraint { max-width: 850px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: 24px; }

    .empty-chat { text-align: center; margin: 80px auto 0; color: #f8fafc; }
    .empty-avatar-wrapper { position: relative; width: 80px; height: 80px; margin: 0 auto 24px; }
    .empty-avatar { position: absolute; inset: 0; font-size: 2.5rem; background: #1e293b; border: 1px solid #334155; border-radius: 24px; display: flex; align-items: center; justify-content: center; z-index: 2; }
    .avatar-ring { position: absolute; inset: -4px; border-radius: 28px; background: linear-gradient(135deg, #ff6600, transparent); animation: spin 4s linear infinite; z-index: 1; }
    
    .empty-chat h3 { font-size: 1.8rem; margin-bottom: 12px; font-weight: 800; }
    .empty-chat p { color: #94a3b8; margin-bottom: 40px; font-size: 1.05rem; }
    
    .suggestion-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; max-width: 650px; margin: 0 auto; }
    .suggestion-btn { background: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 16px; text-align: left; color: #cbd5e1; font-size: 0.95rem; cursor: pointer; transition: all 0.3s ease; line-height: 1.5; }
    .suggestion-btn:hover { background: #334155; border-color: #ff6600; transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); }

    .message-row { display: flex; align-items: flex-start; gap: 16px; max-width: 85%; }
    .user-row { align-self: flex-end; flex-direction: row-reverse; }
    .ai-row { align-self: flex-start; }
    
    .msg-avatar { width: 38px; height: 38px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
    .ai-avatar-small { background: #1e293b; border: 1px solid #334155; }
    
    .message-bubble { padding: 18px 24px; border-radius: 24px; font-size: 1.05rem; line-height: 1.6; word-wrap: break-word; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    .user-bubble { background: #ff6600; color: white; border-top-right-radius: 6px; }
    .ai-bubble { background: #1e293b; color: #f8fafc; border: 1px solid #334155; border-top-left-radius: 6px; }

    .chat-input-area { padding: 24px 30px; background: linear-gradient(0deg, #0f172a 60%, transparent); }

    .input-form { display: flex; gap: 12px; background: #1e293b; border: 1px solid #334155; padding: 10px 10px 10px 20px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); transition: all 0.3s ease; }
    .input-form:focus-within { border-color: #ff6600; box-shadow: 0 10px 30px rgba(255,102,0,0.15); }

    .chat-input { flex: 1; border: none; font-size: 1.05rem; outline: none; background: transparent; color: white; }
    .chat-input::placeholder { color: #64748b; }
    
    .send-btn { width: 48px; height: 48px; border-radius: 14px; background: #334155; color: #94a3b8; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.3s; }
    .send-btn.active-send { background: #ff6600; color: white; }
    .send-btn.active-send:hover { background: #e65c00; transform: translateY(-2px); box-shadow: 0 6px 15px rgba(255,102,0,0.3); }

    .input-footer { text-align: center; font-size: 0.75rem; color: #64748b; margin-top: 14px; }

    /* Animations */
    .slide-up { animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .typing-indicator span { display: inline-block; width: 6px; height: 6px; background: #ff6600; border-radius: 50%; margin: 0 3px; animation: bounce 1.4s infinite ease-in-out both; }
    .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
    .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

    /* Mobile specific adjustments only */
    @@media (max-width: 860px) {
        .ai-sidebar { display: none; }
        .message-row { max-width: 95%; }
        .ai-workspace { margin: -16px; height: calc(100vh - 60px); }
        .chat-header { padding: 16px 20px; }
        .chat-input-area { padding: 16px 20px; }
    }
</style>