@code {
    private ApplicationUser? currentUser;
    private string userId = "";
    private bool loading = true;

    // Email Report State
    private bool isSendingReport = false;
    private string reportStatus = "";

    // Cancellation state
    private bool showCancelModal = false;
    private bool isCanceling = false;

    private List<Product> myProducts = new();
    private List<Product> topProducts = new();
    private List<Review> latestReviews = new();
    private int activeListingsCount = 0;
    private decimal totalInventoryValue = 0;
    private int outOfStockCount = 0;
    private string topCategoryName = "None";

    private BarConfig categoryConfig = new BarConfig();

    private bool isAiOpen = false;
    private string userInput = "";
    private bool isAiTyping = false;
    private List<ChatMessage> chatMessages = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity?.IsAuthenticated == true)
        {
            userId = userPrincipal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
            currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser == null || !currentUser.IsPremiumAgent)
            {
                Nav.NavigateTo("/premium");
                return;
            }

            await LoadDashboardData();
        }
        else
        {
            Nav.NavigateTo("/Account/Login");
            return;
        }
        loading = false;
    }

    private async Task LoadDashboardData()
    {
        myProducts = await Db.Products.Where(p => p.OwnerUserId == userId).ToListAsync();
        activeListingsCount = myProducts.Count;

        totalInventoryValue = myProducts.Sum(p => p.Price * Math.Max(1, p.StockQuantity));
        outOfStockCount = myProducts.Count(p => p.StockQuantity <= 0);

        topProducts = myProducts.OrderByDescending(p => p.Price).Take(3).ToList();

        var categoryGroups = myProducts.GroupBy(p => p.Category)
                                       .Select(g => new { Category = g.Key, Count = g.Count() })
                                       .OrderByDescending(g => g.Count).ToList();

        topCategoryName = categoryGroups.FirstOrDefault()?.Category ?? "None";

        ConfigureCategoryChart(categoryGroups);

        var productIds = myProducts.Select(p => p.Id).ToList();
        if (productIds.Any())
        {
            latestReviews = await Db.Reviews.Where(r => productIds.Contains(r.ProductId)).OrderByDescending(r => r.CreatedAtUtc).Take(4).ToListAsync();
        }
    }

    private async Task GenerateReportAsync()
    {
        if (currentUser == null || string.IsNullOrWhiteSpace(currentUser.Email))
        {
            reportStatus = "No valid email linked to this account.";
            await ClearToast();
            return;
        }

        isSendingReport = true;
        StateHasChanged();

        try
        {
            string reportHtml = $@"
                <div style='font-family: system-ui, -apple-system, sans-serif; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #e2e8f0; border-radius: 12px;'>
                    <h2 style='color: #ff6600; margin-bottom: 5px;'>Z-A-A-T-T PRO</h2>
                    <h3 style='margin-top: 0; color: #0f172a;'>Store Performance Report</h3>
                    <p><strong>Store Name:</strong> {currentUser.UserName}</p>
                    <p><strong>Generated:</strong> {DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm")} UTC</p>
                    
                    <hr style='border: 0; height: 1px; background: #e2e8f0; margin: 20px 0;' />
                    
                    <h4 style='color: #0f172a;'>Inventory Overview</h4>
                    <ul style='list-style: none; padding: 0;'>
                        <li style='margin-bottom: 8px;'>📦 <strong>Active Listings:</strong> {activeListingsCount}</li>
                        <li style='margin-bottom: 8px;'>💰 <strong>Total Catalog Value:</strong> {totalInventoryValue.ToString("C2")}</li>
                        <li style='margin-bottom: 8px;'>⚠️ <strong>Items Out of Stock:</strong> {outOfStockCount}</li>
                    </ul>

                    <h4 style='color: #0f172a;'>Highest Value Assets</h4>
                    <ul style='padding-left: 20px;'>
                        {string.Join("", topProducts.Select(p => $"<li style='margin-bottom: 5px;'>{p.Title} - <strong>{p.Price.ToString("C2")}</strong> ({p.StockQuantity} in stock)</li>"))}
                    </ul>
                    
                    <hr style='border: 0; height: 1px; background: #e2e8f0; margin: 20px 0;' />
                    <p style='font-size: 0.85em; color: #64748b; line-height: 1.5;'>
                        * Note: Sales metrics and exact profit margins will begin populating here automatically once live order processing and checkout logic are deployed to your marketplace.
                    </p>
                </div>
            ";

            await EmailService.SendEmailAsync(currentUser.Email, "Your Z-A-A-T-T PRO Store Report", reportHtml);
            
            reportStatus = "✅ Report sent to your email!";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MailKit failed to send report: {ex.Message}");
            reportStatus = "❌ Failed to send report.";
        }
        
        isSendingReport = false;
        await ClearToast();
    }

    private async Task ClearToast()
    {
        StateHasChanged();
        await Task.Delay(3500);
        reportStatus = "";
        StateHasChanged();
    }

    private async Task CancelSubscriptionAsync()
    {
        if (currentUser == null) return;

        isCanceling = true;
        try
        {
            currentUser.IsPremiumAgent = false;
            await UserManager.UpdateAsync(currentUser);
            Nav.NavigateTo("/premium", forceLoad: true); 
        }
        finally
        {
            isCanceling = false;
            showCancelModal = false;
        }
    }

    private void ConfigureCategoryChart(dynamic categoryData)
    {
        categoryConfig.Options = new BarOptions
        {
            Responsive = true,
            MaintainAspectRatio = false,
            Legend = new Legend { Display = false },
            Scales = new BarScales
            {
                XAxes = new List<CartesianAxis> { new CategoryAxis { GridLines = new GridLines { Display = false }, Ticks = new CategoryTicks { FontColor = "#8b949e" } } },
                YAxes = new List<CartesianAxis> { new LinearCartesianAxis { GridLines = new GridLines { Color = "#1f2937" }, Ticks = new LinearCartesianTicks { FontColor = "#8b949e", BeginAtZero = true } } }
            }
        };

        var labels = new List<string>();
        var dataPoints = new List<int>();
        var colors = new List<string> { "#ff4e45", "#3ea6ff", "#2ba640", "#f59e0b", "#aa47bc" };
        var activeColors = new List<string>();

        int colorIndex = 0;
        foreach (var item in categoryData)
        {
            labels.Add(item.Category);
            dataPoints.Add(item.Count);
            activeColors.Add(colors[colorIndex % colors.Count]);
            colorIndex++;
        }

        foreach (var label in labels) { categoryConfig.Data.Labels.Add(label); }

        var dataset = new BarDataset<int>(dataPoints) { BackgroundColor = activeColors.ToArray(), BorderWidth = 0 };
        categoryConfig.Data.Datasets.Add(dataset);
    }

    private string GetProductTitle(int id) => myProducts.FirstOrDefault(p => p.Id == id)?.Title ?? "Unknown Item";

    private void ToggleAiCopilot() => isAiOpen = !isAiOpen;

    private async Task HandleAiInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userInput) && !isAiTyping) await SendAiMessage();
    }

    private async Task SendAiMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput)) return;

        var userMsg = userInput.Trim();
        chatMessages.Add(new ChatMessage { Text = userMsg, IsAI = false });
        userInput = "";

        isAiTyping = true;
        StateHasChanged();

        await Task.Delay(1500);

        string aiResponse = GenerateDynamicAiResponse(userMsg);
        chatMessages.Add(new ChatMessage { Text = aiResponse, IsAI = true });

        isAiTyping = false;
        StateHasChanged();
    }

    private string GenerateDynamicAiResponse(string prompt)
    {
        prompt = prompt.ToLower();
        if (prompt.Contains("stock") || prompt.Contains("inventory"))
            return outOfStockCount > 0 ? $"Warning: You have **{outOfStockCount} items** currently out of stock." : $"Your inventory is healthy. Valuation: **{totalInventoryValue:C}**.";
        if (prompt.Contains("value") || prompt.Contains("revenue") || prompt.Contains("sales"))
            return $"Your catalog valuation sits at **{totalInventoryValue:C}**. Highest value asset: **{(topProducts.FirstOrDefault()?.Title ?? "N/A")}**.";
        if (prompt.Contains("category") || prompt.Contains("trend"))
            return $"Your store is heavily focused on the **{topCategoryName}** category.";
        if (prompt.Contains("review") || prompt.Contains("rating"))
            return latestReviews.Count > 0 ? $"You have **{latestReviews.Count} recent reviews**. Latest rating: {latestReviews.First().Rating} stars." : "No recent reviews.";
        if (prompt.Contains("hello") || prompt.Contains("yo") || prompt.Contains("hi"))
            return $"Hello there, how may i help you?";
        return "I am processing your live store metrics. Ask about **inventory health**, **catalog value**, or **top categories**.";
    }

    private string FormatMessage(string text)
    {
        var formatted = text.Replace("\n", "<br/>");
        return new System.Text.RegularExpressions.Regex(@"\*\*(.*?)\*\*").Replace(formatted, "<strong>$1</strong>");
    }

    private class ChatMessage { public string Text { get; set; } = ""; public bool IsAI { get; set; } }
}