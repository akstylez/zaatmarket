@code {
    private string activeTab = "Dashboard";

    private string displayName = "User";
    private string email = "Not available";
    private string userId = "Not available";
    private string location = "Not set";
    private string languageDisplay = "English";
    private string profilePicUrl = "";
    private string accountType = "Individual";
    private bool hasUnreadMessages = false;

    private bool updateSuccess = false;
    private bool isSaving = false;
    private bool isUploading = false;
    private ApplicationUser? currentUser;

    private List<Message> recentMessages = new();
    private List<Product> recentListings = new();

    [SupplyParameterFromForm]
    private ProfileInputModel? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new ProfileInputModel();
        await LoadUserData();
    }

    private void SwitchTab(string tabName)
    {
        activeTab = tabName;
        updateSuccess = false;

        if ((tabName == "Settings" || tabName == "About") && currentUser != null && Input != null)
        {
            Input.DisplayName = currentUser.DisplayName ?? "";
            Input.PhoneNumber = currentUser.PhoneNumber ?? "";
            Input.Location = currentUser.Location ?? "";
            Input.PreferredLanguageCode = string.IsNullOrWhiteSpace(currentUser.PreferredLanguage) ? "en" : currentUser.PreferredLanguage;
            Input.ProfilePictureUrl = currentUser.ProfilePictureUrl ?? "";
            Input.SellerDescription = currentUser.SellerDescription ?? "";
        }
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity?.IsAuthenticated == true)
        {
            userId = userPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "Not available";

            if (userId != "Not available")
            {
                using var db = await DbFactory.CreateDbContextAsync();

                currentUser = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);
                hasUnreadMessages = await db.Messages.AnyAsync(m => m.ReceiverId == userId && !m.IsRead);

                recentMessages = await db.Messages
                    .Where(m => m.ReceiverId == userId)
                    .OrderByDescending(m => m.SentAtUtc)
                    .Take(3)
                    .ToListAsync();

                recentListings = await db.Products
                    .Where(p => p.OwnerUserId == userId)
                    .OrderByDescending(p => p.CreatedAtUtc)
                    .Take(3)
                    .ToListAsync();

                if (currentUser != null)
                {
                    displayName = !string.IsNullOrWhiteSpace(currentUser.DisplayName) ? currentUser.DisplayName : (currentUser.Email ?? "User");
                    email = currentUser.Email ?? "Not available";
                    location = currentUser.Location ?? "Not set";
                    profilePicUrl = currentUser.ProfilePictureUrl ?? "";
                    accountType = currentUser.AccountType ?? "Individual";

                    languageDisplay = currentUser.PreferredLanguage switch
                    {
                        "sn" => "Shona",
                        "zh-CN" => "Chinese",
                        "zu" => "Zulu",
                        _ => "English"
                    };
                }
            }
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (Input == null) return;
        isUploading = true;

        try
        {
            var file = e.File;
            var resizedFile = await file.RequestImageFileAsync("image/jpeg", 500, 500);
            var fileName = $"avatar_{userId}_{Guid.NewGuid():N}.jpg";

            await using var stream = resizedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);

            var publicUrl = await StorageService.UploadImageAsync(stream, fileName, "image/jpeg");

            if (publicUrl != null)
            {
                Input.ProfilePictureUrl = publicUrl;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Avatar upload error: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task SaveProfile()
    {
        if (userId == "Not available" || Input == null) return;

        isSaving = true;

        var userToUpdate = await UserManager.FindByIdAsync(userId);
        if (userToUpdate == null)
        {
            isSaving = false;
            return;
        }

        userToUpdate.DisplayName = Input.DisplayName;
        userToUpdate.PhoneNumber = Input.PhoneNumber;
        userToUpdate.Location = Input.Location;
        userToUpdate.ProfilePictureUrl = Input.ProfilePictureUrl;
        userToUpdate.SellerDescription = Input.SellerDescription;

        bool languageChanged = userToUpdate.PreferredLanguage != Input.PreferredLanguageCode;
        userToUpdate.PreferredLanguage = Input.PreferredLanguageCode;

        var result = await UserManager.UpdateAsync(userToUpdate);

        if (result.Succeeded)
        {
            updateSuccess = true;

            if (languageChanged)
            {
                await JSRuntime.InvokeVoidAsync("setLanguageCookie", Input.PreferredLanguageCode);
                Nav.NavigateTo(Nav.Uri, forceLoad: true);
                return;
            }

            await LoadUserData();
        }

        isSaving = false;
    }

    private void GoToListings() => Nav.NavigateTo("/my-listings");
    private void GoToAddProduct() => Nav.NavigateTo("/sell");
    private void GoToProducts() => Nav.NavigateTo("/products");
    private void GoToMessages() => Nav.NavigateTo("/messages");
    private void GoToTracker() => Nav.NavigateTo("/product-tracking");

    private sealed class ProfileInputModel
    {
        [Required(ErrorMessage = "A Display Name is required.")]
        public string DisplayName { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public string Location { get; set; } = "";
        public string PreferredLanguageCode { get; set; } = "en";
        public string ProfilePictureUrl { get; set; } = "";
        public string SellerDescription { get; set; } = "";
    }
}