@page "/agent-dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Models
@using ZaatMarket.Data
@using ZaatMarket.Services     
@using ChartJs.Blazor
@using ChartJs.Blazor.BarChart
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.Common.Enums
@using ChartJs.Blazor.Common.Axes
@using ChartJs.Blazor.Common.Axes.Ticks

@attribute [Authorize]

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject EmailSender EmailService
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Insights | Z-A-A-T-T PRO</PageTitle>

@if (!string.IsNullOrEmpty(reportStatus))
{
    <div class="success-toast fade-in">
        <span class="toast-icon">✓</span> @reportStatus
    </div>
}

@if (loading)
{
    <div class="studio-loading">
        <div class="spinner-premium"></div>
        <div class="loading-text">Initializing PRO Workspace...</div>
    </div>
}
else
{
    <div class="studio-layout">
        
        <aside class="studio-sidebar">
            <div class="agent-profile">
                <div class="avatar-container">
                    <div class="avatar">@currentUser?.UserName?.Substring(0, 1).ToUpper()</div>
                    <div class="pro-badge-mini">PRO</div>
                </div>
                <div class="profile-info">
                    <h4>Your Store</h4>
                    <p>@currentUser?.UserName</p>
                </div>
            </div>

            <nav class="studio-nav">
                <a href="#dashboard" class="active"><span class="icon">📊</span> <span class="nav-text">Dashboard</span></a>
                <a href="/my-listings"><span class="icon">📦</span> <span class="nav-text">Inventory</span></a>
                <a href="/products"><span class="icon">🛍️</span> <span class="nav-text">Marketplace</span></a>
            </nav>

            <div class="sidebar-footer">
                <button class="btn-danger-outline" @onclick="() => showCancelModal = true">
                    Cancel Subscription
                </button>
            </div>
        </aside>

        <main class="studio-main">
            <header class="studio-header">
                <div>
                    <h1>Command Center</h1>
                    <p class="subtitle">Live metrics and store analytics</p>
                </div>
                <div class="header-actions">
                    <button class="btn-report" @onclick="GenerateReportAsync" disabled="@isSendingReport">
                        @(isSendingReport ? "⏳ Generating..." : "📑 Email Report")
                    </button>
                    <button class="btn-create" @onclick='() => Nav.NavigateTo("/sell")'>+ CREATE LISTING</button>
                </div>
            </header>

            <div class="studio-grid">
                
                <div class="grid-col">
                    <div class="studio-card">
                        <div class="card-header">Most Valuable Asset</div>
                        @if (topProducts.Count > 0)
                        {
                            var topItem = topProducts.First();
                            <div class="latest-listing-preview">
                                @if (!string.IsNullOrWhiteSpace(topItem.ImagePath))
                                {
                                    <img src="@topItem.ImagePath" class="thumbnail" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="thumbnail bg-gradient"></div>
                                }
                                <div class="listing-title">@topItem.Title</div>
                            </div>
                            
                            <div class="metrics-list">
                                <div class="metric-row">
                                    <span class="metric-label">Category</span>
                                    <span class="metric-value">@topItem.Category</span>
                                </div>
                                <div class="metric-row">
                                    <span class="metric-label">Listed Price</span>
                                    <span class="metric-value highlight-value">@topItem.Price.ToString("C2")</span>
                                </div>
                                <div class="metric-row">
                                    <span class="metric-label">Current Stock</span>
                                    <span class="metric-value">@topItem.StockQuantity units</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="metrics-list empty-state">
                                No active listings found.
                            </div>
                        }
                        <div class="card-footer">
                            <a href="/my-listings" class="text-link">Manage Stock →</a>
                        </div>
                    </div>
                </div>

                <div class="grid-col">
                    <div class="studio-card">
                        <div class="card-header">Store analytics</div>
                        <div class="analytics-summary">
                            <div class="subscriber-count">
                                <h3>Current active listings</h3>
                                <div class="count-large">@activeListingsCount</div>
                            </div>
                            
                            <div class="summary-divider"></div>
                            
                            <h4>Inventory Summary</h4>
                            <div class="metric-row">
                                <span class="metric-label">Total Catalog Value</span>
                                <span class="metric-value text-glow">@totalInventoryValue.ToString("C2")</span>
                            </div>
                            <div class="metric-row">
                                <span class="metric-label">Items Out of Stock</span>
                                @if (outOfStockCount > 0)
                                {
                                    <span class="metric-value status-danger">@outOfStockCount Action Required</span>
                                }
                                else
                                {
                                    <span class="metric-value status-success">0 (Healthy)</span>
                                }
                            </div>

                            <div class="summary-divider"></div>

                            <h4>Inventory Distribution</h4>
                            <div style="height: 200px; padding-top: 10px;">
                                @if (activeListingsCount > 0)
                                {
                                    <Chart Config="categoryConfig"></Chart>
                                }
                                else
                                {
                                    <div class="empty-state">Add items to see distribution</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="studio-card launch-card">
                        <div class="radar-wrapper">
                            <div class="radar-sweep"></div>
                            <div class="radar-ping ping-1"></div>
                            <div class="radar-ping ping-2"></div>
                        </div>
                        
                        <div class="launch-content">
                            <div class="launch-icon">🛰️</div>
                            <h3>Map Tracker +</h3>
                            <p>Live fleet and delivery logistics</p>
                            <button class="btn-launch" @onclick='() => Nav.NavigateTo("/fleet-command")'>
                                Connect Uplink
                            </button>
                        </div>
                    </div>
                </div>

                <div class="grid-col">
                    <div class="studio-card">
                        <div class="card-header">Recent Customer Reviews</div>
                        <div class="comments-list">
                            @if (latestReviews.Count == 0)
                            {
                                <div class="empty-state">No reviews yet.</div>
                            }
                            else
                            {
                                foreach (var r in latestReviews)
                                {
                                    <div class="comment-item">
                                        <div class="comment-avatar">@r.Rating.ToString()★</div>
                                        <div class="comment-body">
                                            <div class="comment-meta">@r.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                            <div class="comment-text">"@r.Comment"</div>
                                            <div class="comment-target">On: @GetProductTitle(r.ProductId)</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
        </main>

        <button class="ai-trigger-btn" @onclick="ToggleAiCopilot" title="AI Copilot">✨</button>

        <div class="ai-drawer @(isAiOpen ? "open" : "")">
            <div class="drawer-header">
                <div class="ai-title"><span class="ai-icon">✨</span> AI Intelligence</div>
                <button class="close-drawer" @onclick="ToggleAiCopilot">✕</button>
            </div>
            
            <div class="drawer-body" id="ai-chat-body">
                @if (chatMessages.Count == 0)
                {
                    <div class="empty-ai-state">
                        <div class="ai-pulse"></div>
                        <p>I am analyzing your live database.<br/>Ask me about your inventory.</p>
                    </div>
                }

                @foreach (var msg in chatMessages)
                {
                    <div class="msg-row @(msg.IsAI ? "ai-row" : "user-row")">
                        <div class="msg-bubble @(msg.IsAI ? "ai-bubble" : "user-bubble")">
                            @((MarkupString)FormatMessage(msg.Text))
                        </div>
                    </div>
                }

                @if (isAiTyping)
                {
                    <div class="msg-row ai-row">
                        <div class="msg-bubble ai-bubble typing"><span></span><span></span><span></span></div>
                    </div>
                }
            </div>

            <div class="drawer-footer">
                <input type="text" placeholder="Type a prompt..." @bind="userInput" @bind:event="oninput" @onkeydown="HandleAiInput" disabled="@isAiTyping" />
                <button class="send-ai-btn" @onclick="SendAiMessage" disabled="@(string.IsNullOrWhiteSpace(userInput) || isAiTyping)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </div>
        </div>
    </div>

    @if (showCancelModal)
    {
        <div class="modal-backdrop" @onclick="() => showCancelModal = false">
            <div class="cancel-modal" @onclick:stopPropagation="true">
                <div class="modal-icon">⚠️</div>
                <h3>Cancel Subscription?</h3>
                <p>Are you sure you want to cancel your Premium Agent status? You will lose access to the command center, AI insights, and live map tracking immediately.</p>
                <div class="modal-actions">
                    <button class="btn-ghost" @onclick="() => showCancelModal = false">Nevermind, Keep PRO</button>
                    <button class="btn-danger" @onclick="CancelSubscriptionAsync" disabled="@isCanceling">
                        @(isCanceling ? "Canceling..." : "Yes, Cancel Subscription")
                    </button>
                </div>
            </div>
        </div>
    }
}

<style>
    /* ==========================================================================
       GLOBAL OVERRIDES & SCROLL FIX
       ========================================================================== */
    :root {
        --bg-deep: #07090e;
        --panel-bg: #0d1117;
        --border-color: #1f2937;
        --text-primary: #f8fafc;
        --text-secondary: #8b949e;
        --accent-brand: #ff6600;
        --accent-brand-glow: rgba(255, 102, 0, 0.2);
    }

    * { box-sizing: border-box; }

    body, html {
        margin: 0;
        padding: 0;
        overflow-x: hidden; /* Prevents left-to-right scroll globally */
        background-color: var(--bg-deep);
    }

    footer, .footer, .border-top.footer { 
        display: none !important; 
    }

    /* ==========================================================================
       DESKTOP LAYOUT (Preserved Structure, Redesigned Visuals)
       ========================================================================== */
    .studio-layout {
        display: flex;
        height: 100vh;
        width: 100vw;
        max-width: 100%;
        background: var(--bg-deep);
        color: var(--text-primary);
        font-family: system-ui, -apple-system, sans-serif;
        overflow: hidden;
    }

    /* Seamless Sidebar */
    .studio-sidebar {
        width: 260px;
        background: var(--panel-bg);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        z-index: 10;
    }

    .agent-profile {
        padding: 32px 24px;
        display: flex;
        align-items: center;
        gap: 16px;
        border-bottom: 1px solid var(--border-color);
    }

    .avatar-container { position: relative; }
    .avatar {
        width: 48px; height: 48px;
        background: linear-gradient(135deg, #1e293b, #0f172a);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; font-weight: 800; color: var(--text-primary);
    }
    .pro-badge-mini {
        position: absolute; bottom: -6px; right: -6px;
        background: var(--accent-brand); color: white;
        font-size: 0.6rem; font-weight: 800; padding: 2px 6px;
        border-radius: 6px; letter-spacing: 0.5px;
    }

    .profile-info h4 { margin: 0 0 4px 0; font-size: 1.05rem; font-weight: 700; color: var(--text-primary); }
    .profile-info p { margin: 0; font-size: 0.85rem; color: var(--text-secondary); font-weight: 500; }

    .studio-nav { display: flex; flex-direction: column; padding: 24px 12px; gap: 4px; }
    .studio-nav a {
        text-decoration: none; color: var(--text-secondary);
        padding: 14px 16px; border-radius: 8px;
        font-weight: 600; font-size: 0.95rem;
        display: flex; align-items: center; gap: 12px;
        transition: all 0.2s ease;
    }
    .studio-nav a:hover { background: rgba(255, 255, 255, 0.03); color: var(--text-primary); }
    .studio-nav a.active {
        background: rgba(255, 255, 255, 0.05); color: var(--text-primary);
        border-left: 3px solid var(--accent-brand);
    }
    .icon { font-size: 1.2rem; }

    .sidebar-footer { padding: 24px; margin-top: auto; border-top: 1px solid var(--border-color); }
    .btn-danger-outline {
        width: 100%; background: transparent; color: #ef4444; border: 1px solid #ef4444;
        padding: 12px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s;
    }
    .btn-danger-outline:hover { background: rgba(239, 68, 68, 0.1); }

    /* Main Content */
    .studio-main {
        flex: 1; 
        overflow-y: auto;
        overflow-x: hidden;
        padding: 40px;
        background: var(--bg-deep);
    }

    .studio-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 32px; padding-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
    }
    .studio-header h1 { margin: 0 0 8px 0; font-size: 2rem; font-weight: 800; letter-spacing: -0.5px; }
    .subtitle { margin: 0; color: var(--text-secondary); font-size: 1rem; font-weight: 500; }

    .header-actions { display: flex; gap: 12px; align-items: center; }
    .btn-report {
        background: transparent; color: var(--text-primary); border: 1px solid var(--border-color);
        padding: 12px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s;
    }
    .btn-report:hover:not(:disabled) { background: rgba(255,255,255,0.05); }
    .btn-create {
        background: var(--accent-brand); color: white; border: none;
        padding: 12px 24px; border-radius: 8px; font-weight: 700; cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-create:hover { background: #e65c00; }

    /* Flat Panel Grid */
    .studio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    
    .studio-card {
        background: var(--panel-bg);
        border-radius: 12px; border: 1px solid var(--border-color);
        padding: 28px; position: relative;
        display: flex; flex-direction: column;
    }
    
    .card-header { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; color: var(--text-secondary); margin-bottom: 24px; }

    .latest-listing-preview { display: flex; align-items: center; gap: 16px; margin-bottom: 24px; }
    .thumbnail { width: 64px; height: 64px; border-radius: 8px; background: #1e293b; border: 1px solid var(--border-color); }
    .bg-gradient { background: linear-gradient(135deg, #1e293b, #0f172a); }
    .listing-title { font-weight: 700; font-size: 1.1rem; line-height: 1.4; color: var(--text-primary); }

    .metrics-list { display: flex; flex-direction: column; gap: 16px; flex: 1; }
    .metric-row { display: flex; justify-content: space-between; align-items: center; }
    .metric-label { color: var(--text-secondary); font-size: 0.95rem; font-weight: 500; }
    .metric-value { font-weight: 700; color: var(--text-primary); }
    .highlight-value { color: #10b981; }
    .text-glow { color: var(--accent-brand); text-shadow: 0 0 10px var(--accent-brand-glow); font-size: 1.1rem; }
    
    .status-danger { color: #ef4444; background: rgba(239, 68, 68, 0.1); padding: 4px 10px; border-radius: 4px; font-size: 0.85rem; }
    .status-success { color: #10b981; background: rgba(16, 185, 129, 0.1); padding: 4px 10px; border-radius: 4px; font-size: 0.85rem; }

    .empty-state { text-align: center; color: var(--text-secondary); padding: 32px 0; font-size: 0.95rem; font-weight: 500; }

    .card-footer { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border-color); text-align: right; }
    .text-link { color: #3b82f6; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: 0.2s; }
    .text-link:hover { color: #60a5fa; }

    .analytics-summary h3 { margin: 0 0 8px 0; color: var(--text-secondary); font-size: 0.95rem; font-weight: 600; }
    .count-large { font-size: 2.5rem; font-weight: 800; color: var(--text-primary); line-height: 1; }
    .summary-divider { height: 1px; background: var(--border-color); margin: 24px 0; }
    .analytics-summary h4 { margin: 0 0 16px 0; font-size: 1rem; color: var(--text-primary); }

    /* Map Tracker Radar */
    .launch-card {
        overflow: hidden;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; padding: 40px; 
    }
    .radar-wrapper {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 300px; height: 300px; border-radius: 50%;
        border: 1px solid rgba(59, 130, 246, 0.1);
        z-index: 0; pointer-events: none;
    }
    .radar-wrapper::before { content: ''; position: absolute; inset: 25%; border-radius: 50%; border: 1px solid rgba(59, 130, 246, 0.1); }
    .radar-sweep {
        position: absolute; inset: 0; border-radius: 50%;
        background: conic-gradient(from 0deg, transparent 70%, rgba(59, 130, 246, 0.2) 100%);
        animation: radar-spin 4s linear infinite;
    }
    .radar-sweep::after {
        content: ''; position: absolute; top: 0; left: 50%; width: 1px; height: 50%; background: #3b82f6; transform-origin: bottom center;
    }
    .radar-ping {
        position: absolute; width: 6px; height: 6px; background: #60a5fa;
        border-radius: 50%; box-shadow: 0 0 10px #60a5fa; opacity: 0;
    }
    .ping-1 { top: 30%; left: 60%; animation: ping-fade 4s infinite 1s; }
    .ping-2 { top: 60%; left: 30%; animation: ping-fade 4s infinite 3s; }

    .launch-content { position: relative; z-index: 1; }
    .launch-icon { font-size: 2rem; margin-bottom: 16px; }
    .launch-content h3 { margin: 0 0 8px 0; font-size: 1.25rem; font-weight: 800; color: var(--text-primary); }
    .launch-content p { color: var(--text-secondary); margin: 0 0 24px 0; font-size: 0.9rem; }
    
    .btn-launch {
        background: transparent; border: 1px solid #3b82f6; color: #3b82f6;
        padding: 10px 24px; border-radius: 6px; font-weight: 700; cursor: pointer; transition: all 0.2s ease;
        text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem;
    }
    .btn-launch:hover { background: rgba(59, 130, 246, 0.1); }

    /* Reviews */
    .comments-list { display: flex; flex-direction: column; gap: 12px; }
    .comment-item {
        display: flex; gap: 16px; background: rgba(255,255,255,0.02);
        padding: 16px; border-radius: 8px; border: 1px solid transparent;
        transition: 0.2s;
    }
    .comment-item:hover { border-color: var(--border-color); background: rgba(255,255,255,0.04); }
    .comment-avatar {
        width: 36px; height: 36px; border-radius: 8px; flex-shrink: 0;
        background: var(--accent-brand-glow); color: var(--accent-brand);
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 0.8rem;
    }
    .comment-body { flex: 1; }
    .comment-meta { font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .comment-text { color: var(--text-primary); font-size: 0.9rem; line-height: 1.5; margin-bottom: 8px; }
    .comment-target { font-size: 0.8rem; color: #3b82f6; font-weight: 500; }

    /* AI Copilot Component */
    .ai-trigger-btn {
        position: fixed; bottom: 30px; right: 30px; z-index: 100;
        width: 56px; height: 56px; border-radius: 50%;
        background: var(--panel-bg); border: 1px solid var(--border-color);
        font-size: 1.4rem; cursor: pointer; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        transition: 0.3s;
    }
    .ai-trigger-btn:hover { border-color: var(--accent-brand); color: var(--accent-brand); }

    .ai-drawer {
        position: fixed; top: 0; right: -420px; width: 400px; height: 100vh;
        background: rgba(13, 17, 23, 0.95); backdrop-filter: blur(20px);
        border-left: 1px solid var(--border-color); z-index: 999;
        display: flex; flex-direction: column; transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: -10px 0 40px rgba(0,0,0,0.5);
    }
    .ai-drawer.open { right: 0; }

    .drawer-header {
        padding: 24px; border-bottom: 1px solid var(--border-color);
        display: flex; justify-content: space-between; align-items: center;
    }
    .ai-title { font-weight: 800; font-size: 1.1rem; color: var(--text-primary); display: flex; align-items: center; gap: 10px; }
    .close-drawer { background: transparent; border: none; color: var(--text-secondary); font-size: 1.2rem; cursor: pointer; }
    .close-drawer:hover { color: #ef4444; }

    .drawer-body { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
    
    .empty-ai-state { text-align: center; margin: auto 0; color: var(--text-secondary); font-size: 0.9rem; }
    .ai-pulse {
        width: 50px; height: 50px; margin: 0 auto 20px; border-radius: 50%;
        background: radial-gradient(circle, var(--accent-brand-glow) 0%, transparent 70%);
        border: 1px solid rgba(255,102,0,0.3); animation: pulse 2s infinite;
    }

    .msg-row { display: flex; width: 100%; }
    .user-row { justify-content: flex-end; }
    .msg-bubble { max-width: 85%; padding: 12px 16px; border-radius: 12px; font-size: 0.9rem; line-height: 1.5; }
    .user-bubble { background: var(--accent-brand); color: white; border-bottom-right-radius: 2px; }
    .ai-bubble { background: rgba(255,255,255,0.05); color: var(--text-primary); border: 1px solid var(--border-color); border-bottom-left-radius: 2px; }

    .drawer-footer { padding: 20px 24px; border-top: 1px solid var(--border-color); display: flex; gap: 12px; }
    .drawer-footer input {
        flex: 1; background: #000; border: 1px solid var(--border-color); color: white;
        padding: 12px 16px; border-radius: 8px; outline: none; font-size: 0.9rem;
    }
    .drawer-footer input:focus { border-color: var(--accent-brand); }
    .send-ai-btn {
        width: 44px; border-radius: 8px; background: rgba(255,255,255,0.05); color: var(--text-secondary); border: none;
        display: flex; align-items: center; justify-content: center; cursor: pointer; transition: 0.3s;
    }
    .send-ai-btn:not(:disabled):hover { background: var(--accent-brand); color: white; }

    /* Keyframes */
    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes pulse { 0% { transform: scale(0.95); opacity: 0.8; } 50% { transform: scale(1.1); opacity: 0.4; } 100% { transform: scale(0.95); opacity: 0.8; } }
    @@keyframes radar-spin { 100% { transform: rotate(360deg); } }
    @@keyframes ping-fade { 0% { opacity: 0; transform: scale(0.5); } 10% { opacity: 1; transform: scale(1.2); } 100% { opacity: 0; transform: scale(1); } }
    
    .typing span { display: inline-block; width: 6px; height: 6px; background: var(--text-secondary); border-radius: 50%; margin: 0 2px; animation: typing 1.4s infinite ease-in-out both; }
    .typing span:nth-child(1) { animation-delay: -0.32s; }
    .typing span:nth-child(2) { animation-delay: -0.16s; }
    @@keyframes typing { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }

