<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Tab Logo / Favicon -->
    <link rel="icon" type="image/png" href="logo.png" />

    <ResourcePreloader />
    <link rel="stylesheet" href="/css/app.css?v=1" />
    <link rel="stylesheet" href="@Assets["ZaatMarket.styles.css"]" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <ImportMap />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <ReconnectModal />

    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script src="_content/ChartJs.Blazor.Fork/ChartJsBlazorInterop.js"></script>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="js/cartAnimation.js"></script>
    <script src="cartStorage.js"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        // --- 1. Standard Live Tracking ---
        let trackingMap;
        let trackingMarker;
        let watchId;
        let isFirstLoad = true;

        window.startLiveTracking = (elementId, dotNetHelper) => {
        trackingMap = L.map(elementId).setView([-17.8248, 31.0530], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap'
        }).addTo(trackingMap);

        const customIcon = L.divIcon({
        className: 'custom-live-icon',
        html: '<div class="live-core"></div><div class="live-ring"></div>',
        iconSize: [24, 24], iconAnchor: [12, 12]
        });

        trackingMarker = L.marker([-17.8248, 31.0530], { icon: customIcon }).addTo(trackingMap)
        .bindPopup("<b>Courier Vehicle</b><br>In transit to destination.").openPopup();

        if (navigator.geolocation) {
        watchId = navigator.geolocation.watchPosition(
        (position) => {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;
        const newLatLng = new L.LatLng(lat, lng);
        trackingMarker.setLatLng(newLatLng);

        if (isFirstLoad) {
        trackingMap.setView(newLatLng, 16);
        isFirstLoad = false;
        }
        dotNetHelper.invokeMethodAsync("UpdateLocationFromBrowser", lat, lng);
        },
        (error) => { console.error("Tracking error: ", error.message); },
        { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
        );
        }
        };

        window.recenterMapTo = (lat, lng) => {
        if (trackingMap) { trackingMap.setView([lat, lng], 16, { animate: true, duration: 1.5 }); }
        };

        window.stopLiveTracking = () => {
        if (watchId) navigator.geolocation.clearWatch(watchId);
        if (trackingMap) trackingMap.remove();
        };

        // --- 2. Premium Agent Satellite Uplink ---
        let premiumMap;
        let premiumMarker;
        let premiumWatchId;

        window.initializePremiumSatelliteMap = (mapId) => {
        premiumMap = L.map(mapId, { zoomControl: false }).setView([-17.8248, 31.0530], 15);

        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri', maxZoom: 19
        }).addTo(premiumMap);

        const premiumIcon = L.divIcon({
        className: 'premium-agent-marker',
        html: '<div class="pro-core"></div><div class="pro-ring"></div>',
        iconSize: [30, 30], iconAnchor: [15, 15]
        });

        if (navigator.geolocation) {
        premiumWatchId = navigator.geolocation.watchPosition(
        (position) => {
        const newLatLng = new L.LatLng(position.coords.latitude, position.coords.longitude);
        if (!premiumMarker) {
        premiumMarker = L.marker(newLatLng, { icon: premiumIcon }).addTo(premiumMap)
        .bindPopup("<b style='color:#0f172a;'>Agent Terminal</b><br>Live satellite tracking active.").openPopup();
        premiumMap.setView(newLatLng, 17);
        } else {
        premiumMarker.setLatLng(newLatLng);
        }
        },
        (error) => { console.error("Premium tracking error: ", error.message); },
        { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 }
        );
        }
        };

        window.destroyPremiumMap = () => {
        if (premiumWatchId) navigator.geolocation.clearWatch(premiumWatchId);
        if (premiumMap) { premiumMap.remove(); premiumMap = null; premiumMarker = null; }
        };
    </script>

    <script type="text/javascript">
        function googleTranslateElementInit() {
        new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'google_translate_element');
        }

        // This function is called by Blazor when the user saves their language
        window.setLanguageCookie = function (langCode) {
        // If English, clear the translation cookie
        if (langCode === 'en') {
        document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        document.cookie = "googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" + location.hostname;
        } else {
        // Set the translation target
        document.cookie = `googtrans=/en/${langCode}; path=/`;
        document.cookie = `googtrans=/en/${langCode}; path=/; domain=${location.hostname}`;
        }
        };
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Hide the default Google Translate top bar so it looks native to your app -->
    <style>
        .skiptranslate iframe {
        display: none !important;
        }

        body {
        top: 0px !important;
        }

        #google_translate_element {
        display: none;
        }
    </style>

    <script src="/js/audioRecorder.js"></script>
</body>
</html>