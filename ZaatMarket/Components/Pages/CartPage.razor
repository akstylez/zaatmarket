@page "/cart"
@using ZaatMarket.Models
@using ZaatMarket.Services
@inject ICartService Cart
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Your Cart</PageTitle>

<div class="cart-page">
    <div class="cart-header">
        <h1>Your Cart</h1>
        <p>Review your items before checkout.</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading your cart...</p>
        </div>
    }
    else if (!Cart.Items.Any())
    {
        <div class="empty-cart">
            <div class="empty-icon">🛒</div>
            <h3>Your cart is empty</h3>
            <p>Add some products to get started.</p>
            <button class="btn-primary mt-3" @onclick="GoToProducts">Browse Products</button>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Cart.Items)
                {
                    <div class="cart-card">
                        <div class="cart-image-wrap">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Title" class="cart-image" />
                            }
                            else
                            {
                                <div class="cart-image placeholder">No Image</div>
                            }
                        </div>

                        <div class="cart-details">
                            <h3>@item.Title</h3>
                            <p class="price">@item.Price.ToString("C") <span class="muted">each</span></p>
                            <p class="line-total">Total: <strong>@item.LineTotal.ToString("C")</strong></p>
                        </div>

                        <div class="cart-actions">
                            <div class="qty-box">
                                <button class="qty-btn" @onclick="() => Decrease(item.ProductId)">-</button>
                                <span class="qty-value">@item.Quantity</span>
                                <button class="qty-btn" @onclick="() => Increase(item.ProductId)">+</button>
                            </div>

                            <button class="remove-btn" @onclick="() => Remove(item.ProductId)">
                                <span aria-hidden="true">🗑</span> Remove
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="summary-box">
                <h3>Order Summary</h3>

                <div class="summary-row">
                    <span>Items</span>
                    <span class="font-bold">@Cart.Summary.Count</span>
                </div>

                <div class="summary-row total">
                    <span>Total</span>
                    <span class="total-price">@Cart.Summary.Subtotal.ToString("C")</span>
                </div>

                <button class="btn-primary full checkout-btn" @onclick="GoToCheckout">Proceed to Checkout</button>
                <button class="btn-danger full" @onclick="ClearCart">Clear Cart</button>
                <button class="btn-secondary full" @onclick="GoToProducts">Continue Shopping</button>
            </div>
        </div>
    }
</div>

<style>
    .cart-page { max-width: 1100px; margin: 0 auto; padding: 40px 20px; min-height: 80vh; }
    .cart-header h1 { margin-bottom: 8px; font-size: 2.2rem; color: #111827; }
    .cart-header p { color: #6b7280; margin-bottom: 32px; font-size: 1.1rem; }
    .muted { color: #9ca3af; font-size: 0.9rem; font-weight: normal; }
    .font-bold { font-weight: 600; }
    .mt-3 { margin-top: 16px; }

    /* Loading State */
    .loading-state { text-align: center; padding: 60px; color: #6b7280; }
    .spinner { width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #111827; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 16px; }
    
    /* FIX: Double @@ for keyframes in Razor */
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Empty Cart */
    .empty-cart { background: white; border-radius: 24px; padding: 60px 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); text-align: center; border: 1px solid #e5e7eb; }
    .empty-icon { font-size: 4rem; margin-bottom: 16px; opacity: 0.5; }
    .empty-cart h3 { font-size: 1.5rem; color: #111827; margin-bottom: 8px; }
    .empty-cart p { color: #6b7280; }

    /* Layout */
    .cart-layout { display: grid; grid-template-columns: 1fr 380px; gap: 32px; align-items: start; }
    .cart-items { display: flex; flex-direction: column; gap: 16px; }

    /* Cards */
    .cart-card { display: grid; grid-template-columns: 140px 1fr auto; gap: 24px; background: white; border-radius: 20px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #f3f4f6; align-items: center; transition: 0.2s; }
    .cart-card:hover { box-shadow: 0 10px 25px rgba(0,0,0,0.06); transform: translateY(-2px); }

    .cart-image-wrap { width: 140px; height: 140px; }
    .cart-image { width: 100%; height: 100%; object-fit: cover; border-radius: 12px; background: #f9fafb; border: 1px solid #e5e7eb; }
    .placeholder { display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 0.9rem; }

    .cart-details h3 { margin: 0 0 8px 0; font-size: 1.25rem; color: #111827; }
    .price { font-weight: 700; color: #111827; margin-bottom: 12px; font-size: 1.1rem; }
    .line-total { color: #4b5563; margin: 0; background: #f3f4f6; display: inline-block; padding: 4px 12px; border-radius: 6px; font-size: 0.95rem; }

    .cart-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; }

    .qty-box { display: flex; align-items: center; gap: 12px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 6px; }
    .qty-btn { width: 32px; height: 32px; border: none; border-radius: 8px; cursor: pointer; font-size: 1.2rem; background: white; color: #111827; box-shadow: 0 2px 5px rgba(0,0,0,0.05); transition: 0.2s; }
    .qty-btn:hover { background: #111827; color: white; }
    .qty-value { min-width: 24px; text-align: center; font-weight: 700; font-size: 1.1rem; color: #111827; }

    /* Summary Box */
    .summary-box { background: white; border-radius: 24px; padding: 32px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); position: sticky; top: 24px; border: 1px solid #e5e7eb; }
    .summary-box h3 { margin: 0 0 24px 0; font-size: 1.4rem; color: #111827; }
    
    .summary-row { display: flex; justify-content: space-between; margin-bottom: 16px; color: #4b5563; font-size: 1.05rem; }
    .summary-row.total { font-size: 1.3rem; color: #111827; font-weight: 700; border-top: 2px dashed #e5e7eb; padding-top: 20px; margin-top: 20px; margin-bottom: 24px; }
    .total-price { color: #10b981; }

    /* Buttons */
    .btn-primary, .btn-secondary, .btn-danger, .remove-btn { border: none; border-radius: 12px; padding: 14px 20px; cursor: pointer; font-weight: 600; font-size: 1rem; transition: 0.2s; }
    
    .checkout-btn { font-size: 1.1rem; padding: 18px 20px; }
    .btn-primary { background: #111827; color: white; }
    .btn-primary:hover { background: #374151; transform: translateY(-2px); }
    
    .btn-secondary { background: #f3f4f6; color: #4b5563; }
    .btn-secondary:hover { background: #e5e7eb; color: #111827; }
    
    .remove-btn { background: #fee2e2; color: #dc2626; padding: 8px 16px; font-size: 0.9rem; border-radius: 8px; }
    .remove-btn:hover { background: #f87171; color: white; }

    .btn-danger { background: white; border: 1px solid #fca5a5; color: #dc2626; }
    .btn-danger:hover { background: #fee2e2; }

    .full { width: 100%; margin-bottom: 12px; }

    /* FIX: Double @@ for media queries in Razor */
    @@media (max-width: 900px) {
        .cart-layout { grid-template-columns: 1fr; }
        .cart-card { grid-template-columns: 1fr; text-align: center; justify-items: center; }
        .cart-image-wrap { width: 100%; height: 250px; }
        .cart-actions { align-items: center; width: 100%; }
        .qty-box { width: 100%; justify-content: center; }
        .remove-btn { width: 100%; }
        .line-total { margin: 10px auto; }
    }
</style>

@code {
    private bool isLoading = true;

    protected override void OnInitialized()
    {
        Cart.OnChange += HandleCartChanged;
    }

    // NEW: Wait until page renders, then pull the cart from browser storage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Cart.LoadCartAsync();
            isLoading = false;
            StateHasChanged();
        }
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);
    private void Increase(int productId) => Cart.IncreaseQuantity(productId);
    private void Decrease(int productId) => Cart.DecreaseQuantity(productId);
    private void Remove(int productId) => Cart.RemoveFromCart(productId);
    private void ClearCart() => Cart.Clear();
    private void GoToCheckout() => Nav.NavigateTo("/checkout");
    private void GoToProducts() => Nav.NavigateTo("/products");

    public void Dispose()
    {
        Cart.OnChange -= HandleCartChanged;
    }
}