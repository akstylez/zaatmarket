@code {
    private string? currentUserId;
    private string selectedContactId = "";
    private string newMessage = "";
    private bool isRecording = false;

    [SupplyParameterFromQuery(Name = "user")]
    public string? QueryUserId { get; set; }

    [SupplyParameterFromQuery(Name = "product")]
    public string? QueryProductName { get; set; }
    
    private bool showProfileModal = false;
    private ApplicationUser? selectedUserProfile = null;

    public class ContactPreview
    {
        public string UserId { get; set; } = "";
        public string Username { get; set; } = "";
        public string ProfilePictureUrl { get; set; } = "";
        public string AvatarInitials { get; set; } = "";
        public string LastMessagePreview { get; set; } = "";
        public string LastMessageTime { get; set; } = "";
        public bool HasUnread { get; set; }
        public DateTime LastSeen { get; set; }
    }

    private List<ContactPreview> activeContacts = new();
    private List<Message> chatHistory = new();

    protected override async Task OnInitializedAsync()
    {
        PresenceTracker.OnPresenceChanged += RefreshUI;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(currentUserId))
        {
            await LoadContactsAsync();

            if (!string.IsNullOrEmpty(QueryUserId) && QueryUserId != currentUserId)
            {
                if (!activeContacts.Any(c => c.UserId == QueryUserId))
                {
                    using var db = await DbFactory.CreateDbContextAsync();
                    var newUser = await db.Users.FirstOrDefaultAsync(u => u.Id == QueryUserId);
                    if (newUser != null)
                    {
                        string displayUsername = !string.IsNullOrWhiteSpace(newUser.DisplayName) 
                                                ? newUser.DisplayName 
                                                : (newUser.UserName ?? "User");

                        activeContacts.Insert(0, new ContactPreview {
                            UserId = newUser.Id,
                            Username = displayUsername,
                            ProfilePictureUrl = newUser.ProfilePictureUrl ?? "",
                            AvatarInitials = displayUsername.Substring(0, 1).ToUpper(),
                            LastMessagePreview = "New Conversation",
                            LastMessageTime = "Now",
                            HasUnread = false,
                            LastSeen = newUser.LastSeenUtc
                        });
                    }
                }

                await SelectContactAsync(QueryUserId);

                if (!string.IsNullOrEmpty(QueryProductName))
                {
                    newMessage = $"Hi! I am interested in your product: {QueryProductName}. Is it still available?";
                }
            }
        }
    }

    private void RefreshUI()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadContactsAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        var allMyMessages = await db.Messages
            .Where(m => m.SenderId == currentUserId || m.ReceiverId == currentUserId)
            .OrderByDescending(m => m.SentAtUtc)
            .ToListAsync();

        var uniqueContactIds = allMyMessages
            .Select(m => m.SenderId == currentUserId ? m.ReceiverId : m.SenderId)
            .Distinct()
            .ToList();

        var users = await db.Users
            .Where(u => uniqueContactIds.Contains(u.Id))
            .ToListAsync();

        activeContacts.Clear();

        foreach (var id in uniqueContactIds)
        {
            var otherUser = users.FirstOrDefault(u => u.Id == id);
            var lastMsg = allMyMessages.First(m => 
                (m.SenderId == currentUserId && m.ReceiverId == id) || 
                (m.SenderId == id && m.ReceiverId == currentUserId));
            
            string displayUsername = !string.IsNullOrWhiteSpace(otherUser?.DisplayName) 
                                    ? otherUser.DisplayName 
                                    : (otherUser?.UserName ?? "User");
            
            string preview = lastMsg.MessageType == "Image" ? "📷 Image" : 
                             lastMsg.MessageType == "Video" ? "🎥 Video" : 
                             lastMsg.MessageType == "Audio" ? "🎙️ Voice Note" : 
                             lastMsg.Content;

            activeContacts.Add(new ContactPreview {
                UserId = id,
                Username = displayUsername,
                ProfilePictureUrl = otherUser?.ProfilePictureUrl ?? "",
                AvatarInitials = displayUsername.Substring(0, 1).ToUpper(),
                LastMessagePreview = preview,
                LastMessageTime = lastMsg.SentAtUtc.ToLocalTime().ToString("HH:mm"),
                HasUnread = !lastMsg.IsRead && lastMsg.ReceiverId == currentUserId,
                LastSeen = otherUser?.LastSeenUtc ?? DateTime.UtcNow
            });
        }
    }

    private async Task SelectContactAsync(string contactId)
    {
        selectedContactId = contactId;
        
        using var db = await DbFactory.CreateDbContextAsync();
        
        chatHistory = await db.Messages
            .Where(m => (m.SenderId == currentUserId && m.ReceiverId == contactId) || 
                        (m.SenderId == contactId && m.ReceiverId == currentUserId))
            .OrderBy(m => m.SentAtUtc)
            .ToListAsync();

        var unreadMessages = chatHistory.Where(m => m.ReceiverId == currentUserId && !m.IsRead).ToList();
        if (unreadMessages.Any())
        {
            foreach (var msg in unreadMessages)
            {
                msg.IsRead = true;
            }
            await db.SaveChangesAsync();
            
            var contact = activeContacts.FirstOrDefault(c => c.UserId == contactId);
            if (contact != null) contact.HasUnread = false;
        }
        
        await ScrollToBottomAsync();
    }

    private async Task OpenProfileModal()
    {
        if (!string.IsNullOrEmpty(selectedContactId))
        {
            using var db = await DbFactory.CreateDbContextAsync();
            selectedUserProfile = await db.Users.FirstOrDefaultAsync(u => u.Id == selectedContactId);
            if (selectedUserProfile != null)
            {
                showProfileModal = true;
            }
        }
    }

    private void CloseProfileModal()
    {
        showProfileModal = false;
        selectedUserProfile = null;
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || string.IsNullOrEmpty(selectedContactId)) return;

        string messageContent = newMessage;
        
        var msg = new Message 
        { 
            SenderId = currentUserId!, 
            ReceiverId = selectedContactId, 
            Content = messageContent,
            MessageType = "Text",
            SentAtUtc = DateTime.UtcNow,
            IsRead = false 
        };

        using var db = await DbFactory.CreateDbContextAsync();
        db.Messages.Add(msg);
        await db.SaveChangesAsync();

        chatHistory.Add(msg);
        newMessage = "";
        
        await LoadContactsAsync();
        await NotifyReceiverOffline(selectedContactId, messageContent);
        await ScrollToBottomAsync();
    }

    private async Task HandleMediaUpload(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(selectedContactId)) return;

        var file = e.File;
        bool isVideo = file.ContentType.StartsWith("video/");
        
        var folder = Path.Combine(Env.WebRootPath, "chat-media");
        Directory.CreateDirectory(folder);
        var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
        var filePath = Path.Combine(folder, fileName);

        using var stream = file.OpenReadStream(maxAllowedSize: 20971520);
        using var fs = new FileStream(filePath, FileMode.Create);
        await stream.CopyToAsync(fs);

        var msg = new Message 
        { 
            SenderId = currentUserId!, 
            ReceiverId = selectedContactId, 
            MessageType = isVideo ? "Video" : "Image",
            MediaUrl = $"/chat-media/{fileName}",
            Content = "", 
            SentAtUtc = DateTime.UtcNow,
            IsRead = false 
        };

        using var db = await DbFactory.CreateDbContextAsync();
        db.Messages.Add(msg);
        await db.SaveChangesAsync();
        
        chatHistory.Add(msg);
        await LoadContactsAsync();
        await NotifyReceiverOffline(selectedContactId, isVideo ? "Sent a video" : "Sent an image");
        await ScrollToBottomAsync();
    }

    private async Task ToggleRecording()
    {
        if (string.IsNullOrEmpty(selectedContactId)) return;

        if (!isRecording)
        {
            isRecording = true;
            await JSRuntime.InvokeVoidAsync("audioRecorder.start");
        }
        else
        {
            isRecording = false;
            var base64Audio = await JSRuntime.InvokeAsync<string>("audioRecorder.stopAndGetBase64");
            
            if (!string.IsNullOrEmpty(base64Audio))
            {
                await SaveAndSendVoiceNote(base64Audio);
            }
        }
    }

    private async Task SaveAndSendVoiceNote(string base64)
    {
        var bytes = Convert.FromBase64String(base64.Split(',')[1]);
        
        var folder = Path.Combine(Env.WebRootPath, "chat-media");
        Directory.CreateDirectory(folder);
        var fileName = $"voicenote_{Guid.NewGuid()}.webm";
        var filePath = Path.Combine(folder, fileName);

        await File.WriteAllBytesAsync(filePath, bytes);

        var msg = new Message 
        { 
            SenderId = currentUserId!, 
            ReceiverId = selectedContactId, 
            MessageType = "Audio",
            MediaUrl = $"/chat-media/{fileName}",
            Content = "Voice Note",
            SentAtUtc = DateTime.UtcNow,
            IsRead = false
        };

        using var db = await DbFactory.CreateDbContextAsync();
        db.Messages.Add(msg);
        await db.SaveChangesAsync();
        
        chatHistory.Add(msg);
        StateHasChanged();
        await LoadContactsAsync();
        await NotifyReceiverOffline(selectedContactId, "Sent a voice note");
        await ScrollToBottomAsync();
    }

    private async Task NotifyReceiverOffline(string receiverId, string contentPreview)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var receiver = await db.Users.FindAsync(receiverId);
        if (receiver != null && !string.IsNullOrWhiteSpace(receiver.Email))
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.GetUserAsync(authState.User);
            var senderName = !string.IsNullOrWhiteSpace(currentUser?.DisplayName) 
                                    ? currentUser.DisplayName 
                                    : (currentUser?.UserName ?? "A user");
            try
            {
                await EmailService.SendOfflineChatNotificationAsync(receiver.Email, senderName, contentPreview);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"MailKit failed to send: {ex.Message}");
            }
        }
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chat-window");
        }
        catch { }
    }

    public void Dispose()
    {
        PresenceTracker.OnPresenceChanged -= RefreshUI;
    }
}