@page "/edit-product/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Data
@using ZaatMarket.Models
@attribute [Authorize]

@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Edit Listing | ZAATT</PageTitle>

<div class="page-container">
    <div class="edit-card">
        <div class="card-header">
            <h1>Edit Listing</h1>
            <p>Update your product details below</p>
        </div>

        @if (model is null)
        {
            <div class="loading-state">
                <span class="spinner">↻</span> Loading product details...
            </div>
        }
        else if (!isOwner)
        {
            <div class="error-box">
                <span class="error-icon">⚠️</span>
                You do not have permission to edit this product.
            </div>
        }
        else
        {
            <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="editProductForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" style="margin-bottom: 20px; font-weight: 500;" />

                <div class="form-group">
                    <label class="custom-label">Product Title</label>
                    <InputText class="custom-input" @bind-Value="model.Title" placeholder="e.g. Apple MacBook Pro" />
                    <ValidationMessage For="() => model.Title" class="text-danger" />
                </div>

                <div class="form-row">
                    <div class="form-group flex-1">
                        <label class="custom-label">Category</label>
                        <InputText class="custom-input" @bind-Value="model.Category" placeholder="e.g. Electronics" />
                        <ValidationMessage For="() => model.Category" class="text-danger" />
                    </div>

                    <div class="form-group flex-1">
                        <label class="custom-label">Price</label>
                        <div class="price-input-wrapper">
                            <span class="currency-symbol">$</span>
                            <InputNumber class="custom-input price-input" @bind-Value="model.Price" step="0.01" />
                        </div>
                        <ValidationMessage For="() => model.Price" class="text-danger" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="custom-label">Description</label>
                    <InputTextArea class="custom-input textarea" rows="5" @bind-Value="model.Description" placeholder="Describe the condition, features, etc..." />
                    <ValidationMessage For="() => model.Description" class="text-danger" />
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="error-box" style="margin-bottom: 20px;">@error</div>
                }

                <div class="action-buttons">
                    <button type="button" class="btn-cancel" @onclick="@(() => Nav.NavigateTo("/my-listings"))">Cancel</button>
                    <button type="submit" class="btn-save" disabled="@saving">
                        @(saving ? "Saving Changes..." : "Save Changes")
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>

<style>
    :root {
        --bg-color: #f4f5f8;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --primary: #0f172a;
        --accent: #ff6600;
        --accent-hover: #e65c00;
        --danger: #ef4444;
        --radius: 16px;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 12px 24px rgba(15, 23, 42, 0.06);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .page-container {
        min-height: calc(100vh - 80px);
        background: var(--bg-color);
        padding: 40px 20px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .edit-card {
        background: var(--card-bg);
        width: 100%;
        max-width: 650px;
        border-radius: var(--radius);
        padding: 40px;
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border-color);
    }

    .card-header {
        margin-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 20px;
    }

        .card-header h1 {
            margin: 0 0 8px 0;
            font-size: 2rem;
            color: var(--text-main);
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .card-header p {
            margin: 0;
            color: var(--text-muted);
            font-size: 1.05rem;
        }

    .form-group {
        margin-bottom: 24px;
    }

    .form-row {
        display: flex;
        gap: 20px;
    }

    .flex-1 {
        flex: 1;
    }

    .custom-label {
        display: block;
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .custom-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        font-size: 1rem;
        background: #f8fafc;
        transition: var(--transition);
        color: var(--text-main);
        outline: none;
        font-weight: 500;
        font-family: inherit;
    }

        .custom-input:focus {
            border-color: var(--accent);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(255, 102, 0, 0.1);
        }

    .textarea {
        resize: vertical;
        min-height: 120px;
        line-height: 1.5;
    }

    .price-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .currency-symbol {
        position: absolute;
        left: 16px;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .price-input {
        padding-left: 38px;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }

    .btn-cancel {
        background: transparent;
        color: var(--text-muted);
        border: 2px solid var(--border-color);
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: var(--transition);
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: var(--text-main);
            border-color: #cbd5e1;
        }

    .btn-save {
        background: var(--accent);
        color: white;
        border: none;
        padding: 12px 32px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: var(--transition);
        box-shadow: 0 4px 12px rgba(255, 102, 0, 0.2);
    }

        .btn-save:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(255, 102, 0, 0.3);
        }

        .btn-save:disabled {
            background: #fdba74;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    .error-box {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
        padding: 16px;
        border-radius: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--shadow-sm);
    }

    .text-danger {
        color: var(--danger);
        font-size: 0.85rem;
        margin-top: 6px;
        display: block;
        font-weight: 600;
    }

    .loading-state {
        text-align: center;
        padding: 40px;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 1.1rem;
    }

    .spinner {
        display: inline-block;
        animation: spin 1s linear infinite;
        margin-right: 8px;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 600px) {
        .form-row {
            flex-direction: column;
            gap: 0;
        }

        .edit-card {
            padding: 24px;
        }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    [SupplyParameterFromForm]
    private Product? model { get; set; }

    private bool isOwner = false;
    private bool saving = false;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        model ??= await Db.Products.FirstOrDefaultAsync(p => p.Id == Id);

        if (model is null) return;

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        isOwner = !string.IsNullOrWhiteSpace(userId) && model.OwnerUserId == userId;
    }

    private async Task SaveAsync()
    {
        if (model is null || !isOwner) return;

        saving = true;
        error = null;

        try
        {
            model.Id = Id;
            Db.Products.Update(model);
            await Db.SaveChangesAsync();
            Nav.NavigateTo("/my-listings");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}