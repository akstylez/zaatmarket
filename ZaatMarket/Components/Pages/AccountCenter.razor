@page "/account"
@page "/account-center"
@rendermode InteractiveServer

@using System.IO
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Data
@using ZaatMarket.Models
@attribute [Authorize]

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject ZaatMarket.Services.SupabaseStorageService StorageService

<PageTitle>Account Center | ZAATT</PageTitle>

<div class="account-page">
    <div class="account-shell">

        <aside class="account-sidebar">
            <div class="brand-box">
                @if (!string.IsNullOrWhiteSpace(profilePicUrl))
                {
                    <img src="@profilePicUrl" alt="Profile" class="brand-avatar" />
                }
                else
                {
                    <div class="brand-icon">
                        @(!string.IsNullOrWhiteSpace(displayName) ? displayName.Substring(0, 1).ToUpper() : "U")
                    </div>
                }
                <div class="brand-info">
                    <h2>Account Center</h2>
                    <div class="badge-container">
                        @if (accountType == "Business")
                        {
                            <span class="sidebar-badge business-badge">🏢 Business</span>
                        }
                        else
                        {
                            <span class="sidebar-badge ind-badge">👤 Individual</span>
                        }
                    </div>
                </div>
            </div>

            <nav class="side-nav">
                <button type="button" class="nav-btn @(activeTab == "Dashboard" ? "active" : "")" @onclick="@(() => SwitchTab("Dashboard"))">
                    <span class="nav-icon">📊</span> Dashboard
                </button>

                <button type="button" class="nav-btn @(activeTab == "Settings" ? "active" : "")" @onclick="@(() => SwitchTab("Settings"))">
                    <span class="nav-icon">⚙️</span> Settings & Profile
                </button>

                <button type="button" class="nav-btn @(activeTab == "About" ? "active" : "")" @onclick="@(() => SwitchTab("About"))">
                    <span class="nav-icon">💭</span> Bio & About
                </button>

                <hr class="nav-divider" />

                <a href="/my-listings" class="nav-link"><span class="nav-icon">📦</span> My Listings</a>
                <a href="/sell" class="nav-link"><span class="nav-icon">➕</span> Add Product</a>
                <a href="/products" class="nav-link"><span class="nav-icon">🛍️</span> Browse Products</a>
                <a href="/cart" class="nav-link"><span class="nav-icon">🛒</span> My Cart</a>

                <a href="/messages" class="nav-link nav-link-flex">
                    <span><span class="nav-icon">💬</span> Messages</span>
                    @if (hasUnreadMessages)
                    {
                        <span class="notification-dot"></span>
                    }
                </a>

                <a href="/product-tracking" class="nav-link premium-link">📍 Live Tracker / Maps</a>

                @if (currentUser != null && currentUser.IsPremiumAgent)
                {
                    <a href="/agent-dashboard" class="nav-link agent-link">⚡ Agent Dashboard</a>
                }
                else
                {
                    <a href="/premium" class="nav-link upgrade-link">⭐ Upgrade to Pro</a>
                }
            </nav>

            <div class="side-section">
                <form method="post" action="/Account/Logout" data-enhance="false">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="Account/Login" />
                    <button type="submit" class="danger-btn">Log Out Securely</button>
                </form>
            </div>
        </aside>

        <main class="account-main">
            @if (activeTab == "Dashboard")
            {
                <div class="tab-fade-in dashboard-grid">
                    <section class="hero-card full-width">
                        <div class="hero-left">
                            <span class="hero-badge">Overview</span>
                            <div class="hero-title-row">
                                <h1>Welcome, @displayName</h1>

                                @if (accountType == "Business")
                                {
                                    <div class="account-type-pill business-pill">🏢 Verified Business</div>
                                }
                                else
                                {
                                    <div class="account-type-pill ind-pill">👤 Individual Account</div>
                                }

                                @if (currentUser != null && currentUser.IsPremiumAgent)
                                {
                                    <div class="pro-agent-badge">
                                        <span class="pulse-dot"></span> ZAATT PRO
                                    </div>
                                }
                            </div>
                            <p class="hero-text">Keep track of your listings, reviews, messages, and shopping activity from one sleek interface.</p>

                            <div class="user-meta">
                                <div class="meta-chip">
                                    <span class="meta-label">Location</span>
                                    <span class="meta-value">@(string.IsNullOrWhiteSpace(location) ? "Not set" : location)</span>
                                </div>
                                <div class="meta-chip">
                                    <span class="meta-label">Language</span>
                                    <span class="meta-value">@languageDisplay</span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="quick-grid full-width">
                        <div class="quick-card" @onclick="GoToListings">
                            <div class="quick-icon">📦</div>
                            <h3>My Listings</h3>
                            <p>Manage your products</p>
                        </div>
                        <div class="quick-card" @onclick="GoToAddProduct">
                            <div class="quick-icon">➕</div>
                            <h3>Sell Product</h3>
                            <p>Add a new item</p>
                        </div>
                        <div class="quick-card" @onclick="GoToProducts">
                            <div class="quick-icon">🛍️</div>
                            <h3>Browse</h3>
                            <p>Explore marketplace</p>
                        </div>
                        <div class="quick-card tracker-card" @onclick="GoToTracker">
                            <div class="quick-icon">🗺️</div>
                            <h3>Tracker</h3>
                            <p>Live GPS telemetry</p>
                        </div>
                    </section>

                    <section class="dashboard-panel">
                        <div class="panel-header">
                            <h3><span class="icon">💬</span> Message Center</h3>
                            <button type="button" class="text-link" @onclick="GoToMessages">View All</button>
                        </div>
                        <div class="panel-content">
                            @if (recentMessages.Any())
                            {
                                <div class="message-list">
                                    @foreach (var msg in recentMessages)
                                    {
                                        <div class="message-item @(!msg.IsRead ? "unread" : "")" @onclick="GoToMessages">
                                            <div class="msg-avatar">👤</div>
                                            <div class="msg-details">
                                                <div class="msg-top">
                                                    <span class="msg-sender">Buyer Inquiry</span>
                                                    <span class="msg-time">@msg.SentAtUtc.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                                </div>
                                                <p class="msg-preview">@msg.Content</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <div class="empty-icon">📭</div>
                                    <p>Your inbox is empty.</p>
                                </div>
                            }
                        </div>
                    </section>

                    <section class="dashboard-panel">
                        <div class="panel-header">
                            <h3><span class="icon">🏷️</span> Recent Listings</h3>
                            <button type="button" class="text-link" @onclick="GoToListings">Manage</button>
                        </div>
                        <div class="panel-content">
                            @if (recentListings.Any())
                            {
                                <div class="listing-list">
                                    @foreach (var item in recentListings)
                                    {
                                        <div class="listing-item" @onclick="GoToListings">
                                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                            {
                                                <img src="@item.ImagePath" class="listing-img" alt="@item.Title" />
                                            }
                                            else
                                            {
                                                <div class="listing-img-placeholder">📦</div>
                                            }
                                            <div class="listing-details">
                                                <h4>@item.Title</h4>
                                                <span class="listing-price">@item.Price.ToString("C2")</span>
                                            </div>
                                            <span class="listing-status">Active</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <div class="empty-icon">🏬</div>
                                    <p>You haven't listed any products yet.</p>
                                    <button type="button" class="btn-small" @onclick="GoToAddProduct">Create Listing</button>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            }

            @if (activeTab == "Settings" && Input != null)
            {
                <div class="tab-fade-in settings-panel">
                    <div class="settings-header">
                        <div>
                            <h1>Account Settings</h1>
                            <p>Update your personal information, avatar, and preferences.</p>
                        </div>
                        @if (updateSuccess)
                        {
                            <div class="success-pill">✅ Settings Saved</div>
                        }
                    </div>

                    <EditForm Model="Input" OnValidSubmit="SaveProfile" FormName="profile-settings">
                        <DataAnnotationsValidator />

                        <div class="settings-section">
                            <div class="section-info">
                                <h3>Profile Picture</h3>
                                <p>Upload an avatar so buyers know who they are dealing with.</p>
                            </div>
                            <div class="section-content flex-row">
                                <div class="avatar-preview-wrap">
                                    @if (!string.IsNullOrWhiteSpace(Input.ProfilePictureUrl))
                                    {
                                        <img src="@Input.ProfilePictureUrl" alt="Avatar Preview" class="avatar-preview" />
                                    }
                                    else
                                    {
                                        <div class="avatar-placeholder">👤</div>
                                    }
                                </div>
                                <div class="upload-controls">
                                    <InputFile OnChange="HandleFileSelected" accept="image/*" class="file-input" id="avatarUpload" />
                                    <label for="avatarUpload" class="btn-outline">Choose Image</label>
                                    @if (isUploading)
                                    {
                                        <span class="uploading-text">Uploading to Cloud...</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="settings-section">
                            <div class="section-info">
                                <h3>Public Profile</h3>
                                <p>This information will be displayed publicly on your seller profile.</p>
                            </div>
                            <div class="section-content">
                                <div class="form-group">
                                    <label class="form-label">Display Name / Username</label>
                                    <InputText @bind-Value="Input.DisplayName" class="form-control input-sleek" placeholder="e.g. AwesomeSeller99" />
                                    <ValidationMessage For="@(() => Input.DisplayName)" class="validation-msg" />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Location (City, Country)</label>
                                    <InputText @bind-Value="Input.Location" class="form-control input-sleek" placeholder="e.g. Harare, Zimbabwe" />
                                </div>
                                <div class="form-group" style="margin-top: 10px;">
                                    <label class="form-label">Account Type <span class="badge-readonly">Read Only</span></label>
                                    <input type="text" value="@accountType" class="form-control input-sleek read-only" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="settings-section">
                            <div class="section-info">
                                <h3>Marketplace Language</h3>
                                <p>Select your language. The entire marketplace will automatically translate for you.</p>
                            </div>
                            <div class="section-content">
                                <div class="form-group">
                                    <label class="form-label">Preferred Language</label>
                                    <InputSelect @bind-Value="Input.PreferredLanguageCode" class="form-control input-sleek">
                                        <option value="en">English (Default)</option>
                                        <option value="sn">Shona (Chishona)</option>
                                        <option value="zh-CN">Chinese (Simplified)</option>
                                        <option value="zu">Zulu (Ndebele Fallback)</option>
                                    </InputSelect>
                                </div>
                            </div>
                        </div>

                        <div class="settings-section no-border">
                            <div class="section-info">
                                <h3>Contact Information</h3>
                            </div>
                            <div class="section-content">
                                <div class="form-group">
                                    <label class="form-label">Phone Number</label>
                                    <InputText @bind-Value="Input.PhoneNumber" class="form-control input-sleek" placeholder="+263..." />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Email Address <span class="badge-readonly">Read Only</span></label>
                                    <input type="text" value="@email" class="form-control input-sleek read-only" disabled />
                                </div>
                            </div>
                        </div>

                        <div class="settings-actions">
                            <button type="button" class="btn-ghost" @onclick="@(() => SwitchTab("Dashboard"))">Cancel</button>
                            <button type="submit" class="btn-primary" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save All Changes")
                            </button>
                        </div>
                    </EditForm>
                </div>
            }

            @if (activeTab == "About" && Input != null)
            {
                <div class="tab-fade-in settings-panel">
                    <div class="settings-header">
                        <div>
                            <h1>Seller Bio</h1>
                            <p>Manage how buyers know you and your public information.</p>
                        </div>
                        @if (updateSuccess)
                        {
                            <div class="success-pill">✅ Description Saved</div>
                        }
                    </div>

                    <EditForm Model="Input" OnValidSubmit="SaveProfile" FormName="security-settings">
                        <DataAnnotationsValidator />

                        <div class="settings-section no-border">
                            <div class="section-info">
                                <h3>Seller Description</h3>
                                <p>This bio will appear directly above your chat box when buyers message you. Tell them your working hours, return policy, or a little bit about your business to build trust.</p>
                            </div>
                            <div class="section-content">
                                <div class="form-group">
                                    <label class="form-label">Your Public Bio</label>
                                    <InputTextArea @bind-Value="Input.SellerDescription" class="form-control input-sleek textarea-tall" placeholder="e.g. Hi! I usually reply within 10 minutes. I offer a 7-day return policy on all electronics..." />
                                </div>
                            </div>
                        </div>

                        <div class="settings-actions">
                            <button type="button" class="btn-ghost" @onclick="@(() => SwitchTab("Dashboard"))">Cancel</button>
                            <button type="submit" class="btn-primary" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save Bio Settings")
                            </button>
                        </div>
                    </EditForm>
                </div>
            }
        </main>
    </div>
</div>

<style>
    :root {
        --bg-color: #f4f5f8;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --primary: #0f172a;
        --primary-hover: #1e293b;
        --accent: #ff6600;
        --accent-hover: #e65c00;
        --danger: #ef4444;
        --radius: 16px;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 12px 24px rgba(15, 23, 42, 0.06);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .account-page {
        min-height: 100vh;
        background: var(--bg-color);
        padding: 40px 24px;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .account-shell {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 32px;
        align-items: start;
    }

    /* --- Sidebar --- */
    .account-sidebar {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 24px;
        box-shadow: var(--shadow-md);
        position: sticky;
        top: 24px;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 48px);
    }

    .brand-box {
        display: flex;
        gap: 16px;
        align-items: center;
        padding-bottom: 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--border-color);
    }

    .brand-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--primary), #334155);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 800;
        flex-shrink: 0;
        box-shadow: var(--shadow-sm);
    }

    .brand-avatar {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        border: 2px solid var(--border-color);
        flex-shrink: 0;
    }

    .brand-info h2 {
        margin: 0 0 6px 0;
        font-size: 1.15rem;
        color: var(--text-main);
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .badge-container {
        margin-top: 4px;
    }

    .sidebar-badge {
        font-size: 0.7rem;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 6px;
        display: inline-block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .business-badge {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .ind-badge {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .side-nav {
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow-y: auto;
    }

    .nav-btn, .nav-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 12px;
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        cursor: pointer;
        transition: var(--transition);
        text-align: left;
    }

    .nav-link-flex {
        justify-content: space-between;
    }

    .nav-btn:hover, .nav-link:hover {
        background: #f8fafc;
        color: var(--text-main);
        transform: translateX(4px);
    }

    .nav-btn.active {
        background: var(--primary);
        color: white;
        box-shadow: var(--shadow-sm);
        transform: translateX(0);
    }

    .nav-icon {
        font-size: 1.1rem;
    }

    .nav-divider {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 12px 0;
    }

    .notification-dot {
        width: 8px;
        height: 8px;
        background-color: var(--danger);
        border-radius: 50%;
        box-shadow: 0 0 0 4px #fee2e2;
    }

    .premium-link {
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid transparent;
    }

        .premium-link:hover {
            border-color: #bfdbfe;
            background: #dbeafe;
        }

    .agent-link {
        color: #d97706;
        background: #fef3c7;
        border: 1px solid transparent;
    }

        .agent-link:hover {
            border-color: #fde68a;
            background: #fde68a;
        }

    .upgrade-link {
        color: #d97706;
        border: 1px dashed #fcd34d;
        background: transparent;
    }

        .upgrade-link:hover {
            background: #fffbeb;
        }

    .side-section {
        margin-top: auto;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }

    .danger-btn {
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        border: none;
        background: #fef2f2;
        color: var(--danger);
        font-weight: 700;
        cursor: pointer;
        transition: var(--transition);
    }

        .danger-btn:hover {
            background: #fee2e2;
            color: #991b1b;
        }

    /* --- Main Layout --- */
    .account-main {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .hero-card, .dashboard-panel {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 32px;
        box-shadow: var(--shadow-md);
        transition: var(--transition);
    }

        .hero-card:hover, .dashboard-panel:hover {
            box-shadow: var(--shadow-lg);
        }

    /* --- Hero Section --- */
    .hero-badge {
        display: inline-block;
        background: #f1f5f9;
        color: var(--text-muted);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 20px;
    }

    .hero-title-row {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

        .hero-title-row h1 {
            margin: 0;
            font-size: 2.5rem;
            color: var(--text-main);
            font-weight: 800;
            letter-spacing: -0.03em;
        }

    .account-type-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.85rem;
        border: 1px solid transparent;
    }

    .business-pill {
        background: #fff7ed;
        color: #ea580c;
        border-color: #fed7aa;
    }

    .ind-pill {
        background: #f8fafc;
        color: #475569;
        border-color: #e2e8f0;
    }

    .pro-agent-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, var(--primary), #1e293b);
        color: #fbbf24;
        padding: 6px 14px;
        border-radius: 999px;
        font-weight: 800;
        font-size: 0.8rem;
        box-shadow: var(--shadow-sm);
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background: #fbbf24;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(251, 191, 36, 0.4);
        }

        70% {
            box-shadow: 0 0 0 6px rgba(251, 191, 36, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(251, 191, 36, 0);
        }
    }

    .hero-text {
        color: var(--text-muted);
        font-size: 1.1rem;
        max-width: 650px;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .user-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .meta-chip {
        background: #f8fafc;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        padding: 18px 24px;
        flex: 1;
        min-width: 200px;
        transition: var(--transition);
    }

        .meta-chip:hover {
            border-color: #e2e8f0;
            background: #ffffff;
            box-shadow: var(--shadow-sm);
        }

    .meta-label {
        display: block;
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .meta-value {
        color: var(--text-main);
        font-weight: 800;
        font-size: 1.2rem;
    }

    /* --- Quick Actions --- */
    .quick-grid {
        display: grid;
