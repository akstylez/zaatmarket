@page "/sell"
@page "/add-product"
@rendermode InteractiveServer
@implements IDisposable

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Models
@using ZaatMarket.Data
@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime
@inject ZaatMarket.Services.SupabaseStorageService StorageService

<PageTitle>List a Product | ZAATT</PageTitle>

<div class="sell-page-wrapper">
    <div class="sell-container">
        <header class="sell-header">
            <div>
                <h1 class="page-title">List a Product</h1>
                <p class="page-subtitle">Add details, pricing, and inventory to publish to the marketplace.</p>

                <div class="badge-row">
                    @if (accountType == "Business")
                    {
                        <span class="account-badge business-badge">
                            🏢 Listing as a Verified Business
                        </span>
                    }
                    else
                    {
                        <span class="account-badge ind-badge">
                            👤 Listing as an Individual
                        </span>
                    }

                    @if (draftRestored)
                    {
                        <span class="draft-badge">✨ Draft restored from your last session</span>
                    }
                </div>
            </div>
            <button type="button" class="btn-ghost-header" @onclick="@(() => Nav.NavigateTo("/products"))">✕ Cancel</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-error">
                <span class="alert-icon">⚠️</span> @error
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(imageError))
        {
            <div class="alert alert-warning">
                <span class="alert-icon">📸</span> @imageError
            </div>
        }

        <div class="sell-card">
            <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="form-layout">
                    <div class="form-main">
                        <section class="form-section">
                            <h3 class="section-title">Basic Information</h3>

                            <div class="field">
                                <label class="label">Product Title <span class="req">*</span></label>
                                <InputText class="input-sleek" @bind-Value="model.Title" placeholder="e.g. Apple MacBook Pro 14&quot;" />
                                <ValidationMessage For="@(() => model.Title)" class="val-message" />
                            </div>

                            <div class="field">
                                <label class="label">Description <span class="req">*</span></label>
                                <InputTextArea class="input-sleek textarea-tall" @bind-Value="model.Description" placeholder="Describe the condition, features, and specs..." />
                                <ValidationMessage For="@(() => model.Description)" class="val-message" />
                            </div>
                        </section>

                        <section class="form-section">
                            <h3 class="section-title">Media</h3>

                            <div class="field">
                                <label class="label">Product Image</label>
                                <div class="upload-dropzone @((!string.IsNullOrWhiteSpace(previewUrl) || !string.IsNullOrWhiteSpace(model.ImagePath)) ? "has-file" : "")">
                                    <InputFile OnChange="OnFileSelected" class="file-input-hidden" id="fileUpload" accept="image/*" />

                                    @if (!string.IsNullOrWhiteSpace(previewUrl) || !string.IsNullOrWhiteSpace(model.ImagePath))
                                    {
                                        <div class="preview-container">
                                            <img src="@(previewUrl ?? model.ImagePath)" alt="Preview" class="image-preview" />
                                            <label for="fileUpload" class="change-img-btn">📷 Change Photo</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <label for="fileUpload" class="upload-label-area">
                                            <span class="upload-icon">📤</span>
                                            <span class="upload-text">Click to upload an image</span>
                                            <span class="upload-hint">JPG, PNG, WEBP, HEIC (Auto-compressed to 1200px)</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </section>
                    </div>

                    <div class="form-sidebar">
                        <section class="form-section config-section">
                            <h3 class="section-title">Expansion</h3>
                            <div class="field">
                                <label class="label">Category <span class="req">*</span></label>
                                <InputText class="input-sleek" @bind-Value="model.Category" placeholder="e.g. Electronics, Clothing" />
                                <ValidationMessage For="@(() => model.Category)" class="val-message" />
                            </div>
                        </section>

                        <section class="form-section config-section">
                            <h3 class="section-title">Pricing & Inventory</h3>

                            <div class="field">
                                <label class="label">Price ($) <span class="req">*</span></label>
                                <div class="input-with-prefix">
                                    <span class="prefix">$</span>
                                    <InputNumber class="input-sleek with-prefix" @bind-Value="model.Price" min="0.01" step="0.01" />
                                </div>
                                <ValidationMessage For="@(() => model.Price)" class="val-message" />
                            </div>

                            <div class="field">
                                <label class="label">Stock Quantity <span class="req">*</span></label>
                                <div class="input-with-prefix">
                                    <span class="prefix">📦</span>
                                    <InputNumber class="input-sleek with-prefix" @bind-Value="model.StockQuantity" min="1" step="1" />
                                </div>
                                <small class="field-hint">How many items are available for sale?</small>
                                <ValidationMessage For="@(() => model.StockQuantity)" class="val-message" />
                            </div>
                        </section>
                    </div>
                </div>

                <div class="form-footer">
                    <button type="submit" class="btn-publish" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner"></span> <span>Publishing...</span>
                        }
                        else
                        {
                            <span>🚀 Publish Product</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    :root {
        --bg-color: #f4f5f8;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --primary: #0f172a;
        --primary-hover: #1e293b;
        --accent: #ff6600;
        --accent-hover: #e65c00;
        --danger: #ef4444;
        --radius: 16px;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 12px 24px rgba(15, 23, 42, 0.06);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sell-page-wrapper {
        min-height: 100vh;
        background: var(--bg-color);
        padding: 40px 24px;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .sell-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* Header Styles */
    .sell-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0 0 8px 0;
        letter-spacing: -0.03em;
    }

    .page-subtitle {
        font-size: 1.05rem;
        color: var(--text-muted);
        margin: 0;
    }

    .badge-row {
        margin-top: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .account-badge {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
    }

    .business-badge {
        background: #1e293b;
        color: var(--accent);
        border: 1px solid var(--accent);
        box-shadow: var(--shadow-sm);
    }

    .ind-badge {
        background: #ffffff;
        color: var(--text-muted);
        border: 1px solid #cbd5e1;
        box-shadow: var(--shadow-sm);
    }

    .draft-badge {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        animation: fadeIn 0.4s ease-out;
        box-shadow: var(--shadow-sm);
    }

    .btn-ghost-header {
        background: transparent;
        border: 2px solid transparent;
        color: var(--text-muted);
        font-weight: 700;
        cursor: pointer;
        padding: 10px 20px;
        border-radius: 10px;
        transition: var(--transition);
        font-size: 0.95rem;
    }

        .btn-ghost-header:hover {
            background: #e2e8f0;
            color: var(--text-main);
        }

    /* Alerts */
    .alert {
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        box-shadow: var(--shadow-sm);
    }

    .alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert-warning {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
    }

    .alert-icon {
        font-size: 1.2rem;
    }

    /* Main Form Card */
    .sell-card {
        background: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .form-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        border-bottom: 1px solid var(--border-color);
    }

    .form-main {
        padding: 48px;
        border-right: 1px solid var(--border-color);
    }

    .form-sidebar {
        padding: 48px;
        background: #fafaf9;
    }

    .form-section {
        margin-bottom: 48px;
    }

        .form-section:last-child {
            margin-bottom: 0;
        }

    .section-title {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--text-main);
        margin: 0 0 24px 0;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 12px;
    }

    /* Inputs */
    .field {
        margin-bottom: 24px;
    }

    .label {
        display: block;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 10px;
        font-size: 0.95rem;
    }

    .req {
        color: var(--danger);
    }

    .field-hint {
        display: block;
        color: var(--text-muted);
        font-size: 0.85rem;
        margin-top: 8px;
        font-weight: 500;
    }

    .input-sleek {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 1rem;
        background: #f8fafc;
        color: var(--text-main);
        transition: var(--transition);
        box-sizing: border-box;
        font-weight: 500;
        font-family: inherit;
    }

        .input-sleek:focus {
            outline: none;
            border-color: var(--accent);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(255, 102, 0, 0.1);
        }

        .input-sleek::placeholder {
            color: #94a3b8;
        }

    .textarea-tall {
        min-height: 160px;
        resize: vertical;
        line-height: 1.6;
    }

    .input-with-prefix {
        position: relative;
        display: flex;
        align-items: center;
    }

    .prefix {
        position: absolute;
        left: 18px;
        color: var(--text-muted);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .with-prefix {
        padding-left: 44px;
    }

    /* Upload Dropzone */
    .upload-dropzone {
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        padding: 6px;
        text-align: center;
        background: #f8fafc;
        transition: var(--transition);
        position: relative;
        cursor: pointer;
    }

        .upload-dropzone:hover {
            border-color: var(--accent);
            background: #fff7ed;
        }

        .upload-dropzone.has-file {
            border: 2px solid var(--border-color);
            background: white;
            cursor: default;
        }

    .file-input-hidden {
        display: none;
    }

    .upload-label-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 48px 24px;
        cursor: pointer;
    }

    .upload-icon {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.8;
        transition: var(--transition);
    }

    .upload-dropzone:hover .upload-icon {
        transform: translateY(-4px);
        opacity: 1;
    }

    .upload-text {
        font-weight: 800;
        color: var(--text-main);
        font-size: 1.15rem;
        margin-bottom: 6px;
    }

    .upload-hint {
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 500;
    }

    .preview-container {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        background: #f1f5f9;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 280px;
    }

    .image-preview {
        width: 100%;
        max-height: 400px;
        object-fit: contain;
        border-radius: 12px;
    }

    .change-img-btn {
        position: absolute;
        bottom: 20px;
        background: rgba(15, 23, 42, 0.9);
        color: white;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        backdrop-filter: blur(8px);
        transition: var(--transition);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(255,255,255,0.1);
    }

        .change-img-btn:hover {
            background: var(--primary);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

    .val-message {
        color: var(--danger);
        font-size: 0.85rem;
        display: block;
        margin-top: 8px;
        font-weight: 600;
    }

    /* Footer */
    .form-footer {
        padding: 24px 48px;
        background: #f8fafc;
        display: flex;
        justify-content: flex-end;
        border-top: 1px solid var(--border-color);
    }

    .btn-publish {
        background: var(--primary);
        color: white;
        border: none;
        padding: 16px 36px;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 800;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
    }

        .btn-publish:hover:not(:disabled) {
            background: var(--accent);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 102, 0, 0.3);
        }

        .btn-publish:disabled {
            background: #94a3b8;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .spinner {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 1s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 900px) {
        .form-layout {
            grid-template-columns: 1fr;
        }

        .form-sidebar {
            border-top: 1px solid var(--border-color);
        }

        .form-main, .form-sidebar {
            padding: 32px 24px;
        }

        .form-footer {
            padding: 24px;
            justify-content: stretch;
        }

        .btn-publish {
            width: 100%;
            justify-content: center;
            padding: 18px;
        }
    }
</style>

@code {
    private Product model = new() { Price = 1, StockQuantity = 1 };
    private EditContext editContext = default!;
    private string? error;

    private IBrowserFile? selectedFile;
    private string? previewUrl;
    private string? imageError;
    private bool saving;
    private bool draftRestored = false;
    private string accountType = "Individual";

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.FindAsync(userId);
            if (user != null)
            {
                accountType = user.AccountType ?? "Individual";
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedDraft = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "zaat_sell_draft");
                if (!string.IsNullOrWhiteSpace(savedDraft))
                {
                    var draft = JsonSerializer.Deserialize<ProductDraftModel>(savedDraft);
                    if (draft != null && (!string.IsNullOrWhiteSpace(draft.Title) || !string.IsNullOrWhiteSpace(draft.Description)))
                    {
                        model.Title = draft.Title ?? "";
                        model.Description = draft.Description ?? "";
                        model.Category = draft.Category ?? "";
                        if (draft.Price > 0) model.Price = draft.Price;
                        if (draft.StockQuantity > 0) model.StockQuantity = draft.StockQuantity;

                        draftRestored = true;
                        editContext.NotifyValidationStateChanged();
                        StateHasChanged();
                    }
                }

                editContext.OnFieldChanged += OnFieldChanged;
            }
            catch { }
        }
    }

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        _ = SaveDraftQuietly();
    }

    private async Task SaveDraftQuietly()
    {
        try
        {
            var draft = new ProductDraftModel
            {
                Title = model.Title,
                Description = model.Description,
                Category = model.Category,
                Price = model.Price,
                StockQuantity = model.StockQuantity
            };
            var json = JsonSerializer.Serialize(draft);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "zaat_sell_draft", json);
        }
        catch { }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        selectedFile = e.File;
        previewUrl = null;

        try
        {
            var resizedImage = await e.File.RequestImageFileAsync(e.File.ContentType, 800, 800);
            await using var stream = resizedImage.OpenReadStream(10 * 1024 * 1024);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);

            previewUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Preview creation warning: {ex.Message}");
        }
    }

    private async Task SaveAsync()
    {
        error = null;
        imageError = null;
        saving = true;

        try
        {
            if (!editContext.Validate())
            {
                saving = false;
                return;
            }

            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                error = "You must be logged in to sell.";
                saving = false;
                return;
            }

            model.OwnerUserId = userId;
            model.CreatedAtUtc = DateTime.UtcNow;

            if (selectedFile is not null)
            {
                var path = await SaveImageAsync(selectedFile);
                if (path is null)
                {
                    saving = false;
                    return;
                }
                model.ImagePath = path;
            }

            using var db = await DbFactory.CreateDbContextAsync();
            db.Products.Add(model);
            await db.SaveChangesAsync();

            try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "zaat_sell_draft"); } catch { }

            model = new Product { Price = 1, StockQuantity = 1 };
            editContext = new EditContext(model);
            selectedFile = null;
            previewUrl = null;

            Nav.NavigateTo("/products", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<string?> SaveImageAsync(IBrowserFile file)
    {
        const long maxSize = 10 * 1024 * 1024; // 10MB limit

        if (file.Size > maxSize)
        {
            imageError = "Image too large (max 10MB).";
            return null;
        }

        var allowed = new[] { "image/jpeg", "image/png", "image/webp", "image/heic", "image/jpg" };
        if (!allowed.Contains(file.ContentType.ToLower()))
        {
            imageError = "Only JPG, PNG, WEBP or HEIC images allowed.";
            return null;
        }

        var resizedFile = await file.RequestImageFileAsync("image/jpeg", 1200, 1200);
        var fileName = $"prod_{Guid.NewGuid():N}.jpg";

        await using var stream = resizedFile.OpenReadStream(maxSize);

        var publicUrl = await StorageService.UploadImageAsync(stream, fileName, "image/jpeg");

        if (publicUrl == null)
        {
            imageError = "Failed to upload image to cloud storage. Check your Supabase credentials.";
        }

        return publicUrl;
    }

    public void Dispose()
    {
        if (editContext != null)
        {
            editContext.OnFieldChanged -= OnFieldChanged;
        }
    }

    private sealed class ProductDraftModel
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? Category { get; set; }
        public decimal Price { get; set; }
        public int StockQuantity { get; set; }
    }
}