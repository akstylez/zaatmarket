    .chat-header { padding: 16px 30px; border-bottom: 1px solid #1e293b; background: rgba(9, 14, 23, 0.8); backdrop-filter: blur(12px); display: flex; justify-content: space-between; align-items: center; z-index: 10; }
    .header-info h2 { margin: 0; font-size: 1.25rem; color: #f8fafc; font-weight: 800; }
