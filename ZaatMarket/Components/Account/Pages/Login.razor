@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ZaatMarket.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Login | ZaatMarket</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Welcome back</h1>
            <p>Sign in to continue to ZaatMarket.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="alert alert-danger fade-in">
                <span class="alert-icon">⚠️</span> @ErrorMessage
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3 validation-summary" />

            <div class="form-group mb-4">
                <label class="form-label" for="username">Username</label>
                <InputText id="username"
                           @bind-Value="Input.Username"
                           class="form-control"
                           placeholder="Enter your username" />
                <ValidationMessage For="@(() => Input.Username)" class="text-danger validation-msg" />
            </div>

            <div class="form-group mb-3">
                <div class="password-header">
                    <label class="form-label" for="password">Password</label>
                    <a href="/Account/ForgotPassword" class="forgot-link">Forgot password?</a>
                </div>
                <InputText id="password"
                           @bind-Value="Input.Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password" />
                <ValidationMessage For="@(() => Input.Password)" class="text-danger validation-msg" />
            </div>

            <div class="form-check custom-remember-spacing">
                <InputCheckbox @bind-Value="Input.RememberMe"
                               class="form-check-input"
                               id="rememberMe" />
                <label class="form-check-label" for="rememberMe">Remember me for 30 days</label>
            </div>

            <button type="submit" class="btn auth-btn primary-btn">
                Log in
            </button>
        </EditForm>

        <div class="divider">
            <span>or continue with</span>
        </div>

        <form method="post" action="/Account/PerformExternalLogin" @formname="googleLoginForm">
            <AntiforgeryToken />
            <input type="hidden" name="provider" value="Google" />
            <input type="hidden" name="returnUrl" value="@ResolvedReturnUrl" />
            
            <button type="submit" class="btn auth-btn google-btn">
                <svg class="google-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    <path fill="none" d="M0 0h48v48H0z"/>
                </svg>
                Sign in with Google
            </button>
        </form>

        <div class="auth-footer">
            Don't have an account? <a href="/Account/Register">Sign up for free</a>
        </div>
    </div>
</div>

<style>
    /* Base Page Styling */
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: linear-gradient(135deg, #f0f4f8, #e2e8f0);
        font-family: system-ui, -apple-system, sans-serif;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    /* Header */
    .auth-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .auth-header h1 {
        margin: 0 0 8px 0;
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.025em;
    }

    .auth-header p {
        margin: 0;
        color: #64748b;
        font-size: 1rem;
    }

    /* Forms & Inputs */
    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        margin-bottom: 8px;
        font-weight: 600;
        color: #334155;
        font-size: 0.95rem;
    }

    .password-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .forgot-link {
        font-size: 0.85rem;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
    }

    .forgot-link:hover {
        text-decoration: underline;
    }

    .form-control {
        width: 100%;
        min-height: 48px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        padding: 12px 16px;
        font-size: 1rem;
        color: #0f172a;
        background: #f8fafc;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        background: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .form-control::placeholder {
        color: #94a3b8;
    }

    /* Checkbox & Enhanced Spacing */
    .custom-remember-spacing {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 18px;
        margin-bottom: 32px; 
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        border-radius: 6px;
        border: 1.5px solid #cbd5e1;
        cursor: pointer;
        accent-color: #2563eb;
    }

    .form-check-label {
        font-size: 0.95rem;
        color: #475569;
        cursor: pointer;
        user-select: none;
    }

    /* Buttons */
    .auth-btn {
        width: 100%;
        min-height: 50px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
    }

    .primary-btn {
        background: #0f172a;
        color: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.1), 0 2px 4px -1px rgba(15, 23, 42, 0.06);
    }

    .primary-btn:hover {
        background: #1e293b;
        transform: translateY(-1px);
        box-shadow: 0 6px 12px -2px rgba(15, 23, 42, 0.15);
    }

    .google-btn {
        background: #ffffff;
        color: #334155;
        border: 1.5px solid #e2e8f0;
        font-weight: 600;
    }

    .google-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .google-logo {
        width: 22px;
        height: 22px;
    }

    /* Divider */
    .divider {
        display: flex;
        align-items: center;
        margin: 28px 0;
        color: #94a3b8;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .divider::before,
    .divider::after {
        content: "";
        flex: 1;
        border-bottom: 1px solid #e2e8f0;
    }

    .divider span {
        padding: 0 16px;
    }

    /* Validation & Alerts */
    .alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 24px;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-icon {
        font-size: 1.1rem;
    }

    .validation-msg {
        font-size: 0.85rem;
        margin-top: 6px;
        color: #ef4444;
    }

    .validation-summary {
        font-size: 0.9rem;
        color: #ef4444;
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Footer */
    .auth-footer {
        margin-top: 32px;
        text-align: center;
        color: #64748b;
        font-size: 0.95rem;
    }

    .auth-footer a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
        margin-left: 4px;
    }

    .auth-footer a:hover {
        text-decoration: underline;
    }

    /* Responsive */
    @@media (max-width: 480px) {
        .auth-page {
            padding: 16px;
        }

        .auth-card {
            padding: 32px 24px;
            border-radius: 20px;
        }

        .auth-header h1 {
            font-size: 1.75rem;
        }
    }
</style>

@code {
    private string? ErrorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string ResolvedReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl!;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            await httpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;

        var result = await SignInManager.PasswordSignInAsync(
            Input.Username,
            Input.Password,
            Input.RememberMe,
            lockoutOnFailure: false);

        if (result.Succeeded)
        {
            NavigationManager.NavigateTo(ResolvedReturnUrl, true);
            return;
        }

        if (result.RequiresTwoFactor)
        {
            NavigationManager.NavigateTo($"/Account/LoginWith2fa?returnUrl={Uri.EscapeDataString(ResolvedReturnUrl)}&rememberMe={Input.RememberMe}", true);
            return;
        }

        if (result.IsLockedOut)
        {
            NavigationManager.NavigateTo("/Account/Lockout", true);
            return;
        }

        ErrorMessage = "Invalid login attempt. Please check your username and password.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}