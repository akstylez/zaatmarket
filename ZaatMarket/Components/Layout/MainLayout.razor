@inherits LayoutComponentBase
@inject NavigationManager NavManager
@inject ZaatMarket.Services.ICartService Cart
@inject ZaatMarket.Services.CurrencyStateService CurrencyState
@inject ZaatMarket.Services.ToastService ToastService
@implements IDisposable

<div id="progress-bar" class="@progressBarClass"></div>

<div class="page-transition">
    <!-- RESTORED: Top Utility Bar for Currency Switching -->
    <div class="top-utility-bar">
        <div class="utility-inner">
            <span class="utility-text">💱 Currency:</span>
            <select class="currency-selector" value="@CurrencyState.CurrentCurrency" @onchange="ChangeCurrency">
                <option value="USD">USD ($)</option>
                <option value="ZWG">ZWG (ZiG)</option>
                <option value="ZAR">ZAR (R)</option>
            </select>
        </div>
    </div>

    <NavMenu />

    <main class="main-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-col" style="grid-column: span 2;">
                <div class="footer-brand">Z-A-A-T-T</div>
                <p style="color: #888; line-height: 1.6; max-width: 300px;">
                    The premium local marketplace designed for speed, safety, and modern trading. Buy, sell, and connect with your community.
                </p>
            </div>

            <div class="footer-col">
                <h4>Marketplace</h4>
                <ul>
                    <li><a href="/products">All Products</a></li>
                    <li><a href="/categories">Categories</a></li>
                    <li><a href="/sell">Sell an Item</a></li>
                    <li><a href="/stores">Local Stores</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Account</h4>
                <ul>
                    <li><a href="/login" data-enhance-nav="false">Login / Register</a></li>
                    <li><a href="/my-listings">My Listings</a></li>
                    <li><a href="/messages">Messages</a></li>
                    <li><a href="/account" data-enhance-nav="false">Settings</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Support</h4>
                <ul>
                    <li><a href="/help">Help Center</a></li>
                    <li><a href="/safety">Trust & Safety</a></li>
                    <li><a href="/terms">Terms of Service</a></li>
                    <li><a href="/privacy">Privacy Policy</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            &copy; @DateTime.Now.Year ZAATT Marketplace. All rights reserved. &nbsp;|&nbsp; Chemhanza High School
        </div>
    </footer>
</div>

<!-- NEW: Global Floating Toast Container -->
<div class="toast-container">
    @foreach (var toast in ToastService.Messages)
    {
        <div class="toast-item toast-@toast.Type" @onclick="() => ToastService.Remove(toast)">
            <span class="toast-icon">@toast.Icon</span>
            <span class="toast-text">@toast.Message</span>
            <button type="button" class="toast-close">✕</button>
        </div>
    }
</div>

<style>
    /* --- Global Layout Styles --- */
    html, body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8fafc;
    }

    .page-transition {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .main-content {
        flex: 1;
    }

    /* --- Currency Utility Bar --- */
    .top-utility-bar {
        display: flex;
        justify-content: flex-end;
        background-color: #0f172a;
        padding: 6px 20px;
        border-bottom: 1px solid #1e293b;
    }

    .utility-inner {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .utility-text {
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .currency-selector {
        padding: 4px 8px;
        border-radius: 6px;
        border: 1px solid #334155;
        background-color: #1e293b;
        font-weight: 600;
        font-size: 0.85rem;
        color: #f8fafc;
        cursor: pointer;
        outline: none;
        transition: 0.2s;
    }

        .currency-selector:focus {
            border-color: #ff6600;
        }

    /* --- Premium Progress Bar --- */
    #progress-bar {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: linear-gradient(90deg, #ff6600, #ffaa00);
        z-index: 9999;
        width: 0%;
        opacity: 0;
        transition: width 0s, opacity 0.3s ease;
    }

        #progress-bar.loading {
            opacity: 1;
            width: 70%;
            transition: width 0.4s cubic-bezier(0.1, 0.8, 0.2, 1), opacity 0.1s ease;
        }

        #progress-bar.finishing {
            opacity: 1;
            width: 100%;
            transition: width 0.2s ease-out;
        }

    /* --- Global Toast Notifications --- */
    .toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 400px;
        width: calc(100% - 48px);
        pointer-events: none;
    }

    .toast-item {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        border-left: 5px solid #3b82f6;
        cursor: pointer;
        animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        transition: transform 0.2s, opacity 0.2s;
    }

        .toast-item:hover {
            transform: translateY(-2px);
        }

    .toast-success {
        border-left-color: #10b981;
        background: #f0fdf4;
    }

    .toast-error {
        border-left-color: #ef4444;
        background: #fef2f2;
    }

    .toast-warning {
        border-left-color: #f59e0b;
        background: #fffbeb;
    }

    .toast-info {
        border-left-color: #3b82f6;
        background: #eff6ff;
    }

    .toast-icon {
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .toast-text {
        flex: 1;
        font-size: 0.95rem;
        font-weight: 600;
        color: #0f172a;
        line-height: 1.4;
    }

    .toast-close {
        background: none;
        border: none;
        color: #64748b;
        font-weight: bold;
        cursor: pointer;
        padding: 4px;
        font-size: 0.9rem;
    }

    @@keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(100%);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* --- Global Footer Styles --- */
    .site-footer {
        background-color: #0f172a;
        color: #94a3b8;
        padding: 60px 20px 20px 20px;
        margin-top: 60px;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 40px;
        max-width: 1200px;
        margin: 0 auto;
        border-bottom: 1px solid #1e293b;
        padding-bottom: 40px;
    }

    .footer-brand {
        font-size: 1.8rem;
        font-weight: 900;
        color: white;
        margin-bottom: 15px;
        letter-spacing: 1px;
    }

    .footer-col h4 {
        color: white;
        margin-bottom: 20px;
        font-size: 1.1rem;
    }

    .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .footer-col ul li {
            margin-bottom: 10px;
        }

            .footer-col ul li a {
                color: #94a3b8;
                text-decoration: none;
                transition: color 0.2s;
            }

                .footer-col ul li a:hover {
                    color: #ff6600;
                }

    .footer-bottom {
        max-width: 1200px;
        margin: 0 auto;
        padding-top: 20px;
        text-align: center;
        font-size: 0.9rem;
        color: #64748b;
    }
</style>

@code {
    private string progressBarClass = "";

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;

        // FIXED: Use thread-safe handler wrapper instead of subscribing StateHasChanged directly
        CurrencyState.OnCurrencyChanged += HandleStateChanged;
        ToastService.OnChange += HandleStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Restores the user's currency preference from browser localStorage
            await CurrencyState.InitializeAsync();
        }
    }

    private async Task ChangeCurrency(ChangeEventArgs e)
    {
        if (e.Value is string newCurrency)
        {
            await CurrencyState.UpdateCurrencyAsync(newCurrency);
            ToastService.ShowInfo($"Currency switched to {newCurrency}");
        }
    }

    private void HandleStateChanged()
    {
        // FIXED: InvokeAsync ensures Blazor UI thread safety when async services trigger repaints
        InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        progressBarClass = "loading";
        InvokeAsync(StateHasChanged);

        await Task.Delay(250);

        progressBarClass = "finishing";
        await InvokeAsync(StateHasChanged);

        await Task.Delay(200);

        progressBarClass = "";
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        CurrencyState.OnCurrencyChanged -= HandleStateChanged;
        ToastService.OnChange -= HandleStateChanged;
    }
}