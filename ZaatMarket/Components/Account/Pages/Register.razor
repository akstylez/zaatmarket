@page "/Account/Register"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ZaatMarket.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register | ZaatMarket</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Create an account</h1>
            <p>Join ZaatMarket today.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="alert alert-danger fade-in">
                <span class="alert-icon">⚠️</span> @Message
            </div>
        }

        <EditForm Model="FormInput" method="post" OnValidSubmit="PromptAccountType" FormName="register">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" role="alert" />

            <div class="form-group">
                <label class="form-label" for="username">Display Name / Username</label>
                <InputText id="username" 
                           @bind-Value="FormInput.Username" 
                           class="form-control" 
                           autocomplete="username" 
                           aria-required="true" 
                           placeholder="johndoe123" />
                <ValidationMessage For="() => FormInput.Username" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <InputText id="email" 
                           @bind-Value="FormInput.Email" 
                           class="form-control" 
                           autocomplete="email" 
                           aria-required="true" 
                           placeholder="name@example.com" />
                <ValidationMessage For="() => FormInput.Email" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <InputText id="password" 
                           type="password" 
                           @bind-Value="FormInput.Password" 
                           class="form-control" 
                           autocomplete="new-password" 
                           aria-required="true" 
                           placeholder="Create a strong password" />
                <ValidationMessage For="() => FormInput.Password" class="text-danger" />
            </div>

            <div class="form-group">
                <label class="form-label" for="confirm-password">Confirm Password</label>
                <InputText id="confirm-password" 
                           type="password" 
                           @bind-Value="FormInput.ConfirmPassword" 
                           class="form-control" 
                           autocomplete="new-password" 
                           aria-required="true" 
                           placeholder="Repeat your password" />
                <ValidationMessage For="() => FormInput.ConfirmPassword" class="text-danger" />
            </div>

            <div class="auth-btn-container">
                <button type="submit" class="btn auth-btn primary-btn">
                    Next
                </button>
            </div>
        </EditForm>
        
        <div class="auth-links">
            Already have an account? <a href="/Account/Login">Log in</a>
        </div>
    </div>
</div>

@if (showAccountModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            @if (!isBusinessCheckout)
            {
                <h2 class="modal-title">Account Type</h2>
                <p class="modal-subtitle">How will you be using ZaatMarket?</p>
                
                <div class="account-type-options">
                    <div class="type-card @(selectedAccountType == "Individual" ? "selected" : "")" @onclick='() => selectedAccountType = "Individual"'>
                        <div class="type-icon">👤</div>
                        <div class="type-text">
                            <h4>Individual</h4>
                            <p>Free forever. Buy and sell personal items.</p>
                        </div>
                    </div>
                    
                    <div class="type-card business @(selectedAccountType == "Business" ? "selected-biz" : "")" @onclick='() => selectedAccountType = "Business"'>
                        <div class="type-icon">🏢</div>
                        <div class="type-text">
                            <h4>Business</h4>
                            <p>Professional seller account. $5 one-time setup fee.</p>
                        </div>
                    </div>
                </div>
                
                <button class="btn-pay" @onclick="HandleModalNext" type="button">Next</button>
                <button class="btn-cancel" @onclick="() => showAccountModal = false">Cancel</button>
            }
            else
            {
                <h2 class="modal-title">Business Subscription</h2>
                <p class="modal-subtitle">Secure $5 payment for your professional account.</p>
                
                <div class="simulated-payment-box">
                    <span class="pay-amount">$5.00</span>
                    <span class="pay-desc">One-time registration fee</span>
                </div>

                <button class="btn-pay" @onclick="ProcessBusinessPayment" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner"></span> <span>Processing Payment...</span>
                    }
                    else
                    {
                        <span>Pay $5 & Complete Registration</span>
                    }
                </button>
                
                @if (!isProcessing)
                {
                    <button class="btn-cancel" @onclick="() => isBusinessCheckout = false">Back</button>
                }
            }
        </div>
    </div>
}

<style>
    /* ==========================================================================
       BASE PAGE STYLING (Matches Login Theme)
       ========================================================================== */
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: linear-gradient(135deg, #f0f4f8, #e2e8f0);
        font-family: system-ui, -apple-system, sans-serif;
    }

    .auth-card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    /* Header */
    .auth-header {
        text-align: center;
        margin-bottom: 32px;
    }

    .auth-header h1 {
        margin: 0 0 8px 0;
        font-size: 2rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.025em;
    }

    .auth-header p {
        margin: 0;
        color: #64748b;
        font-size: 1rem;
    }

    /* Forms & Inputs */
    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
    }

    .form-label {
        margin-bottom: 8px;
        font-weight: 600;
        color: #334155;
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        min-height: 48px;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        padding: 12px 16px;
        font-size: 1rem;
        color: #0f172a;
        background: #f8fafc;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        background: #ffffff;
        border-color: #3b82f6;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
    }

    .form-control::placeholder {
        color: #94a3b8;
    }

    /* Validation & Alerts */
    .alert {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 24px;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-icon { font-size: 1.1rem; }

    .text-danger {
        color: #ef4444;
        font-size: 0.85rem;
        margin-top: 6px;
        margin-bottom: 0;
    }

    /* Buttons & Spacing */
    .auth-btn-container {
        margin-top: 32px; /* Perfect spacing above the button */
        margin-bottom: 16px;
    }

    .auth-btn {
        width: 100%;
        min-height: 50px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
    }

    .primary-btn {
        background: #0f172a;
        color: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.1), 0 2px 4px -1px rgba(15, 23, 42, 0.06);
    }

    .primary-btn:hover {
        background: #1e293b;
        transform: translateY(-1px);
        box-shadow: 0 6px 12px -2px rgba(15, 23, 42, 0.15);
    }

    /* Links */
    .auth-links {
        margin-top: 24px;
        text-align: center;
        color: #64748b;
        font-size: 0.95rem;
    }

    .auth-links a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
        margin-left: 4px;
    }

    .auth-links a:hover {
        text-decoration: underline;
    }

    /* ==========================================================================
       MODAL STYLES (Dark Toned Premium)
       ========================================================================== */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        animation: fadeIn 0.2s ease-out;
    }

    .modal-card {
        background: #0f172a;
        color: #ffffff;
        padding: 40px;
        border-radius: 24px;
        width: 100%;
        max-width: 440px;
        text-align: center;
        border: 1px solid #1e293b;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-sizing: border-box;
    }

    .modal-title {
        margin: 0 0 8px 0;
        font-size: 1.75rem;
        font-weight: 800;
        color: #f8fafc;
    }

    .modal-subtitle {
        margin: 0 0 32px 0;
        color: #94a3b8;
        font-size: 1rem;
    }

    /* Account Type Cards */
    .account-type-options {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 32px;
    }

    .type-card {
        display: flex;
        align-items: center;
        gap: 20px;
        background: #1e293b;
        color: #ffffff;
        border: 2px solid #334155;
        width: 100%;
        padding: 20px;
        border-radius: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: left;
        box-sizing: border-box;
    }

    .type-card:hover {
        background: #334155;
        transform: translateY(-2px);
    }

    .type-card.selected {
        border-color: #3b82f6;
        background: rgba(59, 130, 246, 0.1);
    }

    .type-card.business.selected-biz {
        border-color: #ff6600;
        background: rgba(255, 102, 0, 0.1);
    }

    .type-icon {
        font-size: 2rem;
        background: #0f172a;
        border-radius: 12px;
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .type-text h4 {
        margin: 0 0 4px 0;
        color: #f8fafc;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .type-text p {
        margin: 0;
        color: #94a3b8;
        font-size: 0.85rem;
        line-height: 1.4;
    }

    /* Payment Simulation */
    .simulated-payment-box {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 32px;
    }

    .pay-amount {
        display: block;
        font-size: 3.5rem;
        font-weight: 800;
        color: #f8fafc;
        line-height: 1;
        margin-bottom: 8px;
    }

    .pay-desc {
        color: #94a3b8;
        font-size: 0.95rem;
    }

    /* Modal Buttons */
    .btn-pay {
        width: 100%;
        background: #ff6600;
        color: white;
        border: none;
        min-height: 54px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .btn-pay:hover:not(:disabled) {
        background: #e65c00;
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(255, 102, 0, 0.3);
    }

    .btn-pay:disabled {
        background: #334155;
        color: #94a3b8;
        cursor: not-allowed;
    }

    .btn-cancel {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        padding: 12px;
        width: 100%;
        margin-top: 12px;
        transition: color 0.2s;
    }

    .btn-cancel:hover { color: #f8fafc; }

    /* Animations */
    .spinner {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(255, 255, 255, 0.2);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    /* Responsive */
    @@media (max-width: 480px) {
        .auth-page { padding: 16px; }
        .auth-card { padding: 32px 24px; border-radius: 20px; }
        .auth-header h1 { font-size: 1.75rem; }
        .modal-card { padding: 32px 24px; border-radius: 20px; }
    }
</style>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel FormInput { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message => identityErrors is null
        ? null
        : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    private bool showAccountModal = false;
    private bool isBusinessCheckout = false;
    private bool isProcessing = false;
    
    private string selectedAccountType = "Individual";

    public void PromptAccountType()
    {
        showAccountModal = true;
    }

    public async Task HandleModalNext()
    {
        if (selectedAccountType == "Business")
        {
            isBusinessCheckout = true;
        }
        else
        {
            await RegisterUser("Individual");
        }
    }

    public async Task ProcessBusinessPayment()
    {
        isProcessing = true;
        StateHasChanged(); 
        
        await Task.Delay(2500); 
        
        await RegisterUser("Business");
    }

    public async Task RegisterUser(string accountType)
    {
        var user = CreateUser();

        user.DisplayName = FormInput.Username;
        user.AccountType = accountType;

        await UserStore.SetUserNameAsync(user, FormInput.Username, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, FormInput.Email, CancellationToken.None);

        var result = await UserManager.CreateAsync(user, FormInput.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            showAccountModal = false;
            isProcessing = false;
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

        await EmailSender.SendConfirmationLinkAsync(user, FormInput.Email, HtmlEncoder.Default.Encode(callbackUrl));

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo("Account/RegisterConfirmation", new Dictionary<string, object?> { ["email"] = FormInput.Email });
            return;
        }

        RedirectManager.RedirectTo("Account/Login", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl ?? "/" });
    }

    private ApplicationUser CreateUser()
    {
        try { return Activator.CreateInstance<ApplicationUser>()!; }
        catch { throw new InvalidOperationException($"Can't create an account of '{nameof(ApplicationUser)}'."); }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail) { throw new NotSupportedException("The default UI requires a user store with email support."); }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(50, MinimumLength = 3)]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}