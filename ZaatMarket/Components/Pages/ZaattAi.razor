@page "/zaatt-ai"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Models
@using ZaatMarket.Data
@using ZaatMarket.Services
@using Microsoft.JSInterop

@* Forces the user to be logged in to save their history *@
@attribute [Authorize]

@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider
@inject ZaattAiService AiService
@inject IJSRuntime JS

<PageTitle>Z-A-A-T-T AI | Intelligent Assistant</PageTitle>

<div class="ai-workspace">
    <aside class="ai-sidebar">
        <div class="sidebar-header">
            <button class="new-chat-btn" @onclick="StartNewChat">
                <span class="plus-icon">＋</span> New Chat
            </button>
        </div>

        <div class="history-list">
            <div class="history-label">Your Conversations</div>
            
            @if (isLoading)
            {
                <div style="color: #64748b; font-size: 0.85rem; padding: 10px 0;">Loading history...</div>
            }
            else if (SavedSessions.Count == 0 || (SavedSessions.Count == 1 && SavedSessions[0].Messages.Count == 0))
            {
                <div style="color: #64748b; font-size: 0.85rem; padding: 10px 0;">No chat history yet.</div>
            }
            else
            {
                @foreach (var session in SavedSessions.OrderByDescending(s => s.CreatedAt))
                {
                    if (session.Messages.Count > 0)
                    {
                        <button class="history-item @(ActiveSession.Id == session.Id ? "active" : "")" 
                                @onclick="() => LoadSession(session.Id)">
                            <span class="chat-icon">💬</span> @session.Title
                        </button>
                    }
                }
            }
        </div>
        
        <div class="sidebar-footer">
            <div class="ai-badge">
                <span class="glow-dot"></span> System Online
            </div>
        </div>
    </aside>

    <main class="ai-main">
        <header class="chat-header">
            <div class="header-info">
                <h2>Z-A-A-T-T Intelligence</h2>
                <div class="status-wrapper">
                    <span class="status-dot"></span> 
                    <span class="status-text">Powered by Gemini</span>
                </div>
            </div>
            @if (ActiveSession.Messages.Any())
            {
                <button class="clear-btn" @onclick="DeleteCurrentSession" title="Delete Conversation permanently">
                    🗑️ Delete
                </button>
            }
        </header>

        <div class="chat-window" id="chat-window">
            <div class="chat-content-constraint">
                @if (ActiveSession.Messages.Count == 0)
                {
                    <div class="empty-chat slide-up">
                        <div class="empty-avatar-wrapper">
                            <div class="empty-avatar">✨</div>
                            <div class="avatar-ring"></div>
                        </div>
                        <h3>How can I assist you today?</h3>
                        <p>I can help optimize your product descriptions, analyze pricing, or navigate the marketplace.</p>
                        
                        <div class="suggestion-grid">
                            <button class="suggestion-btn" @onclick="@(() => SetInput("Write a catchy description for a used MacBook Pro 14-inch."))">
                                "Write a catchy description for a used MacBook Pro 14-inch."
                            </button>
                            <button class="suggestion-btn" @onclick="@(() => SetInput("Give me 3 tips to make my ZaatMarket listings stand out."))">
                                "Give me 3 tips to make my ZaatMarket listings stand out."
                            </button>
                        </div>
                    </div>
                }
                
                @foreach (var msg in ActiveSession.Messages.OrderBy(m => m.SentAt))
                {
                    <div class="message-row @(msg.IsUser ? "user-row" : "ai-row") slide-up">
                        @if (!msg.IsUser)
                        {
                            <div class="msg-avatar ai-avatar-small">✨</div>
                        }
                        <div class="message-bubble @(msg.IsUser ? "user-bubble" : "ai-bubble")">
                            @((MarkupString)msg.Text.Replace("\n", "<br/>"))
                        </div>
                    </div>
                }

                @if (isTyping)
                {
                    <div class="message-row ai-row slide-up">
                        <div class="msg-avatar ai-avatar-small">✨</div>
                        <div class="message-bubble ai-bubble typing-indicator">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                }
                <div id="chat-anchor" style="height: 1px;"></div>
            </div>
        </div>

        <div class="chat-input-area">
            <div class="chat-content-constraint">
                <EditForm Model="this" OnValidSubmit="SendMessage" class="input-form">
                    <InputText @bind-Value="currentInput" 
                               class="chat-input" 
                               placeholder="Message Z-A-A-T-T AI..." 
                               disabled="@isTyping" 
                               @onkeyup="HandleEnter" 
                               autocomplete="off" />
                               
                    <button type="submit" class="send-btn @(!string.IsNullOrWhiteSpace(currentInput) ? "active-send" : "")" disabled="@(string.IsNullOrWhiteSpace(currentInput) || isTyping)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    </button>
                </EditForm>
                <div class="input-footer">Z-A-A-T-T AI can make mistakes. Consider verifying important marketplace transactions.</div>
            </div>
        </div>
    </main>
</div>

<script>
    window.scrollToBottom = (elementId) => {
        var element = document.getElementById(elementId);
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    }
</script>

<style>
