</style>

@code {
    private string? currentUserId;
    private bool isLoading = true;
    
    private List<ChatSession> SavedSessions = new();
    private ChatSession ActiveSession = new();
    
    private string currentInput = "";
    private bool isTyping = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(currentUserId))
        {
            await LoadUserSessionsFromDbAsync();
        }
        
        isLoading = false;
    }

    private async Task LoadUserSessionsFromDbAsync()
    {
        SavedSessions = await Db.ChatSessions
            .Include(s => s.Messages)
            .Where(s => s.UserId == currentUserId)
            .OrderByDescending(s => s.CreatedAt)
            .ToListAsync();

        if (SavedSessions.Any())
        {
            ActiveSession = SavedSessions.First();
        }
        else
        {
            StartNewChat();
        }
    }

    private void StartNewChat()
    {
        if (ActiveSession.Messages.Count == 0) return;

        ActiveSession = new ChatSession { UserId = currentUserId! };
        currentInput = "";
        isTyping = false;
        StateHasChanged();
    }

    private void LoadSession(string sessionId)
    {
        var sessionToLoad = SavedSessions.FirstOrDefault(s => s.Id == sessionId);
        if (sessionToLoad != null)
        {
            ActiveSession = sessionToLoad;
            StateHasChanged();
            _ = ScrollToBottomAsync();
        }
    }

    private async Task DeleteCurrentSession()
    {
        var dbSession = await Db.ChatSessions.FindAsync(ActiveSession.Id);
        if (dbSession != null)
        {
            Db.ChatSessions.Remove(dbSession);
            await Db.SaveChangesAsync(); 
        }

        await LoadUserSessionsFromDbAsync();
        StateHasChanged();
    }

    private void SetInput(string text)
    {
        currentInput = text;
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentInput) || string.IsNullOrEmpty(currentUserId)) return;

        var userMsgText = currentInput.Trim();
        currentInput = ""; 
        isTyping = true;
        StateHasChanged(); 
        await ScrollToBottomAsync(); 

        bool isNewSession = !Db.ChatSessions.Any(s => s.Id == ActiveSession.Id);
        
        if (isNewSession)
        {
            ActiveSession.Title = userMsgText.Length > 25 ? userMsgText.Substring(0, 25) + "..." : userMsgText;
            Db.ChatSessions.Add(ActiveSession);
            SavedSessions.Insert(0, ActiveSession);
        }

        var userMessage = new AiMessage 
        { 
            ChatSessionId = ActiveSession.Id,
            Text = userMsgText, 
            IsUser = true 
        };
        
        ActiveSession.Messages.Add(userMessage);
        
        if (!isNewSession) 
        {
            Db.AiMessages.Add(userMessage);
        }
        
        await Db.SaveChangesAsync(); 

        var aiResponseText = await AiService.GetChatResponseAsync(ActiveSession.Messages);

        var aiMessage = new AiMessage 
        { 
            ChatSessionId = ActiveSession.Id,
            Text = aiResponseText, 
            IsUser = false 
        };
        
        ActiveSession.Messages.Add(aiMessage);
        Db.AiMessages.Add(aiMessage);
        
        await Db.SaveChangesAsync(); 
        
        isTyping = false;
        StateHasChanged();
        await ScrollToBottomAsync();
    }

    private async Task ScrollToBottomAsync()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", "chat-window"); } catch { }
    }
}