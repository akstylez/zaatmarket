@page "/fleet-command"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Models
@using ZaatMarket.Data

@attribute [Authorize]
@implements IAsyncDisposable

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Premium | Z-A-A-T-T PRO</PageTitle>

@if (loading)
{
    <div class="fullscreen-loading">
        <div class="spinner"></div>
        <p>CONNECTING....</p>
    </div>
}
else
{
    <div class="fleet-command-wrapper">
        <div id="fullscreen-satellite-map"></div>

        <div class="glass-overlay">
            <header class="overlay-header">
                <button class="btn-back" @onclick='() => Nav.NavigateTo("/agent-dashboard")'>
                    ← Dashboard
                </button>
                <div class="status-badge">
                    <span class="dot"></span> Active
                </div>
            </header>

            <div class="overlay-controls">
                <div class="control-panel">
                    <h2>Map Status</h2>
                    <div class="stat-row">
                        <span>Active Couriers</span>
                        <strong>7</strong>
                    </div>
                    <div class="stat-row">
                        <span>Network Latency</span>
                        <strong class="good">12ms</strong>
                    </div>
                    <div class="stat-row">
                        <span>GPS Accuracy</span>
                        <strong class="good">High (±3m)</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ApplicationUser? currentUser;
    private bool loading = true;
    private bool isBrowserContext = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(userPrincipal);
            
            if (currentUser == null || !currentUser.IsPremiumAgent)
            {
                Nav.NavigateTo("/premium");
                return;
            }
        }
        else
        {
            Nav.NavigateTo("/Account/Login");
            return;
        }

        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !loading)
        {
            isBrowserContext = true;
            await JS.InvokeVoidAsync("initializePremiumSatelliteMap", "fullscreen-satellite-map");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (isBrowserContext)
        {
            try { await JS.InvokeVoidAsync("destroyPremiumMap"); } catch { }
        }
    }
}