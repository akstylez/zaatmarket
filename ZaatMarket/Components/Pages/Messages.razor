@page "/messages"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ZaatMarket.Models
@using ZaatMarket.Data
@using ZaatMarket.Services
@attribute [Authorize]

@inject PresenceService PresenceTracker
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject EmailSender EmailService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject IJSRuntime JSRuntime

<PageTitle>Chat Center | Z-A-A-T-T</PageTitle>

<div class="chat-container">
    <aside class="chat-sidebar">
        <div class="sidebar-header">
            <h2>Messages</h2>
        </div>
        
        <div class="contacts-list">
            @if (activeContacts.Count == 0)
            {
                <div class="no-contacts-msg">No messages yet.</div>
            }
            @foreach (var contact in activeContacts)
            {
                <div class="contact-card @(selectedContactId == contact.UserId ? "active" : "")" 
                     @onclick="() => SelectContactAsync(contact.UserId)">
                    
                    <div class="avatar-wrap">
                        @if (!string.IsNullOrWhiteSpace(contact.ProfilePictureUrl))
                        {
                            <img src="@contact.ProfilePictureUrl" alt="@contact.Username" class="avatar-img" />
                        }
                        else
                        {
                            <div class="avatar-initials">@contact.AvatarInitials</div>
                        }
                    </div>

                    <div class="contact-info">
                        <div class="contact-top">
                            <h4>@contact.Username</h4>
                            <span class="time">@contact.LastMessageTime</span>
                        </div>
                        <p class="preview @(contact.HasUnread ? "unread-text" : "")">
                            @contact.LastMessagePreview
                        </p>
                    </div>
                    @if (contact.HasUnread)
                    {
                        <div class="unread-dot"></div>
                    }
                </div>
            }
        </div>
    </aside>

    <main class="chat-main">
        @if (string.IsNullOrEmpty(selectedContactId))
        {
            <div class="no-chat-selected">
                <div class="icon">💬</div>
                <h3>Your Conversations</h3>
                <p>Select a chat from the left menu to start messaging.</p>
            </div>
        }
        else
        {
            var currentContact = activeContacts.First(c => c.UserId == selectedContactId);

            <header class="chat-header">
                <div class="header-user-info" @onclick="OpenProfileModal" style="cursor: pointer;" title="Click to view profile">
                    <div class="avatar-wrap">
                        @if (!string.IsNullOrWhiteSpace(currentContact.ProfilePictureUrl))
                        {
                            <img src="@currentContact.ProfilePictureUrl" alt="@currentContact.Username" class="avatar-img" />
                        }
                        else
                        {
                            <div class="avatar-initials">@currentContact.AvatarInitials</div>
                        }
                    </div>
                    <div class="header-text">
                        <h3>@currentContact.Username</h3>
                        @if (PresenceTracker.IsOnline(currentContact.UserId))
                        {
                            <span class="status online">● Online</span>
                        }
                        else
                        {
                            <span class="status offline">Last seen @currentContact.LastSeen.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                        }
                    </div>
                </div>
                
                <button class="view-profile-btn" @onclick="OpenProfileModal">View Profile</button>
            </header>

            <div class="chat-history" id="chat-window">
                @foreach (var msg in chatHistory)
                {
                    <div class="bubble-wrapper @(msg.SenderId == currentUserId ? "mine" : "theirs")">
                        <div class="chat-bubble">
                            @if (msg.MessageType == "Text" || string.IsNullOrEmpty(msg.MessageType))
                            {
                                <p>@msg.Content</p>
                            }
                            else if (msg.MessageType == "Image")
                            {
                                <img src="@msg.MediaUrl" class="chat-media-img" alt="Attached Image" />
                                @if(!string.IsNullOrEmpty(msg.Content)) { <p class="media-caption">@msg.Content</p> }
                            }
                            else if (msg.MessageType == "Video")
                            {
                                <video src="@msg.MediaUrl" controls class="chat-media-video"></video>
                            }
                            else if (msg.MessageType == "Audio")
                            {
                                <audio src="@msg.MediaUrl" controls class="chat-media-audio"></audio>
                            }

                            <div class="msg-footer">
                                <span class="timestamp">@msg.SentAtUtc.ToLocalTime().ToString("HH:mm")</span>
                                
                                @if (msg.SenderId == currentUserId)
                                {
                                    <span class="read-receipt">
                                        @if (msg.IsRead)
                                        {
                                            <span style="color: #3b82f6;">✓✓</span>
                                        }
                                        else if (PresenceTracker.IsOnline(msg.ReceiverId))
                                        {
                                            <span style="color: #cbd5e1;">✓✓</span>
                                        }
                                        else
                                        {
                                            <span style="color: #cbd5e1;">✓</span>
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
                <div id="chat-anchor" style="height: 1px;"></div>
            </div>

            <div class="chat-input-area">
                <InputFile OnChange="HandleMediaUpload" accept="image/*,video/*" id="mediaUpload" style="display:none;" />
                <label for="mediaUpload" class="chat-btn attachment-btn" title="Send Picture/Video">📎</label>

                <input type="text" class="chat-input" 
                       placeholder="Type your message..." 
                       @bind="newMessage" 
                       @bind:event="oninput" 
                       @onkeyup="HandleEnter" />
                
                @if (!string.IsNullOrWhiteSpace(newMessage))
                {
                    <button class="send-btn" @onclick="SendMessageAsync">Send</button>
                }
                else
                {
                    <button class="chat-btn mic-btn @(isRecording ? "recording" : "")" @onclick="ToggleRecording" title="Voice Note">
                        @(isRecording ? "⏹️" : "🎙️")
                    </button>
                }
            </div>
        }
    </main>
</div>

@if (showProfileModal && selectedUserProfile != null)
{
    <div class="modal-backdrop" @onclick="CloseProfileModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseProfileModal">✕</button>
            
            <div class="modal-header-bg"></div>
            
            <div class="modal-profile-content">
                <div class="modal-avatar-container">
                    @if (!string.IsNullOrWhiteSpace(selectedUserProfile.ProfilePictureUrl))
                    {
                        <img src="@selectedUserProfile.ProfilePictureUrl" alt="Profile" class="modal-avatar" />
                    }
                    else
                    {
                        <div class="modal-avatar-initials">@selectedUserProfile.DisplayName?.Substring(0,1).ToUpper() ?? selectedUserProfile.UserName?.Substring(0,1).ToUpper()</div>
                    }
                </div>
                
                <h2 class="modal-username">@(!string.IsNullOrWhiteSpace(selectedUserProfile.DisplayName) ? selectedUserProfile.DisplayName : selectedUserProfile.UserName)</h2>
                
                <div class="modal-meta">
                    <div class="meta-item">
                        <span class="meta-icon">📍</span>
                        <span>@(string.IsNullOrWhiteSpace(selectedUserProfile.Location) ? "Location not set" : selectedUserProfile.Location)</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-icon">🗣️</span>
                        <span>Speaks @(string.IsNullOrWhiteSpace(selectedUserProfile.PreferredLanguage) ? "English" : selectedUserProfile.PreferredLanguage)</span>
                    </div>
                </div>
                
                <button class="modal-msg-btn" @onclick="CloseProfileModal">Continue Chatting</button>
            </div>
        </div>
    </div>
}

<script>
    window.scrollToBottom = (elementId) => {
        var element = document.getElementById(elementId);
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    }
</script>

