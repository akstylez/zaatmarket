@page "/checkout"
@rendermode InteractiveServer
@implements IDisposable

@using ZaatMarket.Services
@using ZaatMarket.Models
@using ZaatMarket.Data
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization

@inject ICartService Cart
@inject PaynowService Paynow
@inject NavigationManager Nav
@inject ApplicationDbContext Db
@inject EmailSender EmailService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Secure Checkout | ZAATT</PageTitle>

<div class="checkout-page">
    <div class="checkout-wrap">
        <h1 class="page-title">Secure Checkout</h1>
        <p class="page-subtitle">Complete your payment and finalize your order securely.</p>

        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="status-banner @(StatusIsError ? "error" : "success")">
                <span class="banner-icon">@(StatusIsError ? "⚠️" : "✅")</span> @StatusMessage
            </div>
        }

        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading checkout session...</p>
            </div>
        }
        else
        {
            <div class="checkout-grid">
                <!-- Order Summary Section -->
                <section class="checkout-card summary-card">
                    <h2>Order Summary</h2>

                    @if (Items.Count == 0)
                    {
                        <div class="empty-state">
                            <div class="empty-icon">🛒</div>
                            <p>Your cart is empty.</p>
                            <button class="btn-secondary mt-3" @onclick="GoToProducts">Go to Products</button>
                        </div>
                    }
                    else
                    {
                        <div class="summary-items-list">
                            @foreach (var item in Items)
                            {
                                <div class="summary-row">
                                    <div class="item-main">
                                        <div class="item-name">@item.Name</div>
                                        <div class="item-meta">Qty: @item.Quantity</div>
                                    </div>
                                    <div class="item-total">
                                        @FormatMoney(item.Price * item.Quantity)
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="summary-total-box">
                            <span>Total Amount</span>
                            <strong>@FormatMoney(Total)</strong>
                        </div>

                        <div class="summary-actions">
                            <button class="btn-danger-outline" @onclick="ClearCart">Clear Cart</button>
                            <button class="btn-secondary" @onclick="GoToCart">Edit Cart</button>
                        </div>
                    }
                </section>

                <!-- Payment Details Section -->
                <section class="checkout-card payment-card">
                    <h2>Checkout Details</h2>

                    <EditForm Model="PaymentInput" OnValidSubmit="ProcessRealPaymentAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />

                        <!-- Contact Details -->
                        <h3 class="section-subtitle">Contact Information</h3>
                        <div class="field">
                            <label for="fullName">Full Name</label>
                            <InputText id="fullName" @bind-Value="PaymentInput.FullName" class="input-sleek" disabled="@IsProcessingPayment" placeholder="e.g. John Doe" />
                            <ValidationMessage For="@(() => PaymentInput.FullName)" class="val-msg" />
                        </div>

                        <div class="field">
                            <label for="email">Email Address</label>
                            <InputText id="email" @bind-Value="PaymentInput.Email" class="input-sleek" disabled="@IsProcessingPayment" placeholder="e.g. john@example.com" />
                            <ValidationMessage For="@(() => PaymentInput.Email)" class="val-msg" />
                        </div>

                        <!-- Logistics & Delivery (Hidden if Digital Subscription) -->
                        @if (!IsSubscriptionOrder)
                        {
                            <h3 class="section-subtitle">Logistics & Delivery</h3>
                            <div class="field-row">
                                <div class="field">
                                    <label for="deliveryFrom">Dispatch Origin (From)</label>
                                    <InputText id="deliveryFrom" @bind-Value="PaymentInput.DeliveryFrom" class="input-sleek" placeholder="e.g. Harare" disabled="@IsProcessingPayment" />
                                    <ValidationMessage For="@(() => PaymentInput.DeliveryFrom)" class="val-msg" />
                                </div>
                                <div class="field">
                                    <label for="deliveryTo">Final Destination (To)</label>
                                    <InputText id="deliveryTo" @bind-Value="PaymentInput.DeliveryTo" class="input-sleek" placeholder="e.g. Bulawayo" disabled="@IsProcessingPayment" />
                                    <ValidationMessage For="@(() => PaymentInput.DeliveryTo)" class="val-msg" />
                                </div>
                            </div>
                        }

                        <!-- Payment Method -->
                        <h3 class="section-subtitle">Payment Method</h3>
                        <div class="payment-tabs">
                            <button class="tab-btn @(SelectedMethod == "EcoCash" ? "active" : "")"
                                    @onclick="@(() => SelectMethod("EcoCash"))" type="button" disabled="@IsProcessingPayment">
                                📱 EcoCash
                            </button>
                            <button class="tab-btn @(SelectedMethod == "Card" ? "active" : "")"
                                    @onclick="@(() => SelectMethod("Card"))" type="button" disabled="@IsProcessingPayment">
                                💳 Visa / Mastercard
                            </button>
                        </div>

                        @if (SelectedMethod == "EcoCash")
                        {
                            <div class="field slide-in">
                                <label for="phone">EcoCash Number</label>
                                <InputText id="phone" @bind-Value="PaymentInput.PhoneNumber" class="input-sleek" placeholder="e.g. 0771234567" disabled="@IsProcessingPayment" />
                                <ValidationMessage For="@(() => PaymentInput.PhoneNumber)" class="val-msg" />
                            </div>
                        }
                        else
                        {
                            <div class="secure-notice slide-in">
                                <div class="secure-icon">🔒</div>
                                <div>
                                    <strong>Secure Redirect</strong>
                                    <p>You will be securely redirected to Paynow to enter your card details.</p>
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn-primary full mt-4" disabled="@(IsProcessingPayment || Items.Count == 0)">
                            @if (IsProcessingPayment)
                            {
                                <span class="spinner-small"></span> <span>Processing Payment...</span>
                            }
                            else if (SelectedMethod == "EcoCash")
                            {
                                <span>Pay @FormatMoney(Total) via EcoCash</span>
                            }
                            else
                            {
                                <span>Proceed to Secure Card Payment ➔</span>
                            }
                        </button>
                    </EditForm>
                </section>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --bg-color: #f4f5f8;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --primary: #0f172a;
        --accent: #ff6600;
        --accent-hover: #e65c00;
        --danger: #ef4444;
        --radius: 16px;
        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 12px 24px rgba(15, 23, 42, 0.06);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .checkout-page {
        min-height: calc(100vh - 80px);
        background: var(--bg-color);
        padding: 40px 24px 60px;
        font-family: system-ui, -apple-system, sans-serif;
    }

    .checkout-wrap {
        max-width: 1100px;
        margin: 0 auto;
    }

    .page-title {
        font-size: 2.5rem;
        margin: 0 0 6px;
        color: var(--text-main);
        font-weight: 800;
        letter-spacing: -0.02em;
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 1.1rem;
        margin: 0 0 32px 0;
    }

    .status-banner {
        margin-bottom: 24px;
        padding: 16px 20px;
        border-radius: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--shadow-sm);
    }

        .status-banner.error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        .status-banner.success {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #86efac;
        }

    .loading-state {
        text-align: center;
        padding: 60px;
        color: var(--text-muted);
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e5e7eb;
        border-top-color: var(--text-main);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 16px;
    }

    .spinner-small {
        width: 18px;
        height: 18px;
        border: 3px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        display: inline-block;
        vertical-align: middle;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 32px;
        align-items: start;
    }

    .checkout-card {
        background: var(--card-bg);
        border-radius: var(--radius);
        padding: 32px;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-color);
    }

        .checkout-card h2 {
            margin: 0 0 20px;
            font-size: 1.4rem;
            color: var(--text-main);
            font-weight: 800;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 16px;
        }

    .section-subtitle {
        margin: 28px 0 16px;
        font-size: 1.05rem;
        color: var(--text-main);
        font-weight: 700;
    }

    .field-row {
        display: flex;
        gap: 16px;
    }

        .field-row .field {
            flex: 1;
        }

    .payment-tabs {
        display: flex;
        gap: 10px;
        margin-bottom: 24px;
        background: #f1f5f9;
        padding: 6px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
    }

    .tab-btn {
        flex: 1;
        padding: 12px;
        border: none;
        background: transparent;
        border-radius: 8px;
        font-weight: 700;
        color: var(--text-muted);
        cursor: pointer;
        transition: var(--transition);
    }

        .tab-btn.active {
            background: white;
            color: var(--text-main);
            box-shadow: var(--shadow-sm);
        }

    .secure-notice {
        display: flex;
        gap: 16px;
        align-items: center;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        padding: 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        color: #166534;
    }

    .secure-icon {
        font-size: 1.5rem;
    }

    .secure-notice p {
        margin: 4px 0 0;
        font-size: 0.9rem;
        color: #15803d;
        font-weight: 500;
    }

    .slide-in {
        animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .summary-items-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        max-height: 350px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .summary-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 16px;
        align-items: center;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-color);
    }

    .item-name {
        font-weight: 700;
        color: var(--text-main);
        font-size: 1.05rem;
    }

    .item-meta {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-top: 4px;
        font-weight: 500;
    }

    .item-total {
        font-weight: 800;
        color: var(--text-main);
        text-align: right;
        font-size: 1.05rem;
    }

    .summary-total-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 24px;
        margin-top: 24px;
        border-top: 2px dashed var(--border-color);
        font-size: 1.3rem;
        font-weight: 800;
        color: var(--text-main);
    }

        .summary-total-box strong {
            color: #10b981;
        }

    .summary-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

        .summary-actions button {
            flex: 1;
        }

    .field {
        margin-bottom: 20px;
    }

        .field label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            color: var(--text-main);
            font-size: 0.95rem;
        }

    .input-sleek {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 1rem;
        background: #f8fafc;
        color: var(--text-main);
        transition: var(--transition);
        box-sizing: border-box;
        font-weight: 500;
        font-family: inherit;
    }

        .input-sleek:focus {
            outline: none;
            border-color: var(--accent);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(255, 102, 0, 0.1);
        }

        .input-sleek::placeholder {
            color: #94a3b8;
        }

    .validation-summary {
        color: var(--danger);
        margin-bottom: 16px;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .val-msg {
        color: var(--danger);
        font-size: 0.85rem;
        margin-top: 6px;
        font-weight: 600;
        display: block;
    }

    .btn-primary, .btn-secondary, .btn-danger-outline {
        border: none;
        border-radius: 12px;
        padding: 14px 20px;
        cursor: pointer;
        font-weight: 700;
        font-size: 1rem;
        transition: var(--transition);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-primary {
        background: var(--accent);
        color: white;
        box-shadow: 0 4px 12px rgba(255, 102, 0, 0.2);
    }

        .btn-primary:hover:not(:disabled) {
            background: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(255, 102, 0, 0.3);
        }

        .btn-primary:disabled {
            background: #fdba74;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

    .btn-secondary {
        background: #f3f4f6;
        color: var(--text-muted);
        border: 2px solid var(--border-color);
    }

        .btn-secondary:hover {
            background: #e2e8f0;
            color: var(--text-main);
        }

    .btn-danger-outline {
        background: #fef2f2;
        color: var(--danger);
        border: 1px solid #fecaca;
    }

        .btn-danger-outline:hover {
            background: #fee2e2;
        }

    .full {
        width: 100%;
    }

    .mt-3 {
        margin-top: 16px;
    }

    .mt-4 {
        margin-top: 24px;
    }

    .empty-state {
        text-align: center;
        padding: 40px 0;
        color: var(--text-muted);
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 12px;
        opacity: 0.6;
    }

    @@media (max-width: 900px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .field-row {
            flex-direction: column;
            gap: 0;
        }
    }
</style>

@code {
    private bool isLoading = true;
    private string? StatusMessage;
    private bool StatusIsError;
    private bool IsProcessingPayment;
    private string SelectedMethod = "EcoCash";

    private PaymentInputModel PaymentInput { get; set; } = new();
    private List<OrderItem> Items { get; set; } = new();

    private decimal Total => Items.Sum(x => x.Price * x.Quantity);

    // Check if the cart contains the PRO subscription
    private bool IsSubscriptionOrder => Items.Any(i => i.Name.Contains("Z-A-A-T-T PRO"));

    protected override void OnInitialized()
    {
        Cart.OnChange += HandleCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Cart.LoadCartAsync();
            LoadCartItems();
            isLoading = false;

            // If it's a digital subscription, auto-fill the delivery fields to bypass validation
            if (IsSubscriptionOrder)
            {
                PaymentInput.DeliveryFrom = "Digital Upgrade";
                PaymentInput.DeliveryTo = "Account System";
            }

            StateHasChanged();
        }
    }

    private void HandleCartChanged()
    {
        LoadCartItems();
        InvokeAsync(StateHasChanged);
    }

    private void SelectMethod(string method)
    {
        SelectedMethod = method;
        if (method == "Card")
        {
            PaymentInput.PhoneNumber = "N/A";
        }
        else
        {
            PaymentInput.PhoneNumber = "";
        }
    }

    private void LoadCartItems()
    {
        Items = Cart.Items.Select(c => new OrderItem
        {
            Name = c.Title,
            Price = c.Price,
            Quantity = c.Quantity
        }).ToList();
    }

    private async Task ProcessRealPaymentAsync()
    {
        StatusMessage = null;
        StatusIsError = false;

        if (Items.Count == 0) return;

        if (SelectedMethod == "EcoCash")
        {
            var normalizedPhone = NormalizeZimbabwePhone(PaymentInput.PhoneNumber);
            if (normalizedPhone is null)
            {
                StatusMessage = "Enter a valid Zimbabwe EcoCash number.";
                StatusIsError = true;
                return;
            }
            PaymentInput.PhoneNumber = normalizedPhone;
        }

        IsProcessingPayment = true;
        StateHasChanged();

        try
        {
            var reference = $"ZAAT-{DateTime.UtcNow:yyyyMMddHHmmss}-{Random.Shared.Next(100, 999)}";
            var itemNameSummary = Items.Count == 1 ? Items.First().Name : $"ZaatMarket Order: {Items.Count} items";

            // 1. Create and save the order to the database
            var newOrder = new Order
            {
                Reference = reference,
                TotalAmount = Total,
                CustomerName = PaymentInput.FullName,
                CustomerEmail = PaymentInput.Email,
                DeliveryFrom = PaymentInput.DeliveryFrom,
                DeliveryTo = PaymentInput.DeliveryTo,
                Status = "Pending"
            };

            Db.Orders.Add(newOrder);
            await Db.SaveChangesAsync();

            // 2. Send the Email Receipt
            try
            {
                await EmailService.SendOrderReceiptAsync(
                    toEmail: PaymentInput.Email,
                    customerName: PaymentInput.FullName,
                    orderReference: reference,
                    totalAmount: Total,
                    deliveryFrom: PaymentInput.DeliveryFrom,
                    deliveryTo: PaymentInput.DeliveryTo
                );
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to send receipt: {ex.Message}");
            }

            // 3. Process Payment via Paynow
            if (SelectedMethod == "EcoCash")
            {
                var result = await Paynow.StartEcoCashPaymentAsync(
                    reference, PaymentInput.Email, PaymentInput.PhoneNumber, Total, itemNameSummary);

                if (result.Success)
                {
                    StatusMessage = "Please check your phone for the USSD prompt.";

                    // Trigger Database Upgrade immediately since it's a subscription
                    if (IsSubscriptionOrder) await UpgradeUserToPremiumAgent();

                    Cart.Clear();
                    Items.Clear();
                }
                else
                {
                    StatusMessage = $"EcoCash Error: {result.Error}";
                    StatusIsError = true;
                }
            }
            else if (SelectedMethod == "Card")
            {
                StatusMessage = "Connecting to Secure Gateway...";

                var result = await Paynow.StartWebPaymentAsync(
                            reference, PaymentInput.Email, Total, itemNameSummary);

                if (result.Success && !string.IsNullOrEmpty(result.RedirectLink))
                {
                    // Trigger Database Upgrade immediately since we are navigating away
                    if (IsSubscriptionOrder) await UpgradeUserToPremiumAgent();

                    Cart.Clear();
                    Nav.NavigateTo(result.RedirectLink);
                }
                else
                {
                    StatusMessage = $"Gateway Error: {result.Error}";
                    StatusIsError = true;
                }
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Payment failed: {ex.Message}";
            StatusIsError = true;
        }
        finally
        {
            IsProcessingPayment = false;
            StateHasChanged();
        }
    }

    private async Task UpgradeUserToPremiumAgent()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            var userToUpdate = await UserManager.FindByIdAsync(userId);
            if (userToUpdate != null)
            {
                userToUpdate.IsPremiumAgent = true;
                await UserManager.UpdateAsync(userToUpdate);
            }
        }
    }

    private static string? NormalizeZimbabwePhone(string? input)
    {
        if (string.IsNullOrWhiteSpace(input) || input == "N/A") return null;
        var digits = new string(input.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("263") && digits.Length == 12) return digits;
        if (digits.StartsWith("07") && digits.Length == 10) return "263" + digits[1..];
        return null;
    }

    private void ClearCart()
    {
        Cart.Clear();
        Items.Clear();
    }

    private void GoToCart() => Nav.NavigateTo("/cart");
    private void GoToProducts() => Nav.NavigateTo("/products");
    private static string FormatMoney(decimal amount) => amount.ToString("C2", CultureInfo.CreateSpecificCulture("en-US"));

    public void Dispose()
    {
        Cart.OnChange -= HandleCartChanged;
    }

    private sealed class PaymentInputModel
    {
        [Required(ErrorMessage = "Full name is required.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Valid email required.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Origin destination is required.")]
        public string DeliveryFrom { get; set; } = string.Empty;

        [Required(ErrorMessage = "Final destination is required.")]
        public string DeliveryTo { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required for EcoCash.")]
        public string PhoneNumber { get; set; } = string.Empty;
    }

    private sealed class OrderItem
    {
        public string Name { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Quantity { get; set; }
    }
}